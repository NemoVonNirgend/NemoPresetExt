            "identifier": "v11-190-genre-fluff",
            "name": "🎬 Fluff",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Fluff genre lens. Low-stakes tenderness, care rituals, domestic warmth, gentle humor, and comfort-forward scenes. }}\n{{// @color #FF69B4 }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Fluff}}\n\n<genre_fluff>\n<genre_tags>Fluff,⠀Comfort,⠀Tenderness,⠀Domesticity,⠀Low-Stakes,⠀Sweetness,⠀Gentle-Humor,⠀Safe-Proximity,⠀Care-Ritual</genre_tags>\n<scene_selection>Shared-Food,⠀Blanket-Offering,⠀Sleepy-Conversation,⠀Grocery-Trip,⠀Pet-Care,⠀Rainy-Day-Inside,⠀Tiny-Gift,⠀Handheld-Errand,⠀Quiet-Reassurance</scene_selection>\n{{#if {{getvar::NemoInterpreterEnabled}}}}<pressure_tags>Bashfulness,⠀Sincerity-Risk,⠀Small-Disagreement,⠀Overcaring,⠀Awkward-Kindness,⠀Want-To-Stay,⠀Being-Seen-Softly</pressure_tags>{{else}}<pressure_tags>Bashfulness,⠀Sincerity-Risk,⠀Small-Misunderstanding,⠀Overcaring,⠀Awkward-Kindness,⠀Want-To-Stay,⠀Being-Seen-Softly</pressure_tags>{{/if}}\n<character_roles>Soft-Teaser,⠀Secret-Caretaker,⠀Sleepy-Grump,⠀Overprepared-Friend,⠀Person-Who-Remembers-Preferences,⠀Person-Bad-At-Accepting-Care</character_roles>\n<world_behavior>Problems-Remain-Manageable,⠀Care-Has-Material-Form,⠀Rooms-Become-Safer,⠀Community-Feels-Available,⠀Conflict-Resolves-Without-Cruelty</world_behavior>\n<motif_tags>Warm-Mug,⠀Shared-Umbrella,⠀Folded-Laundry,⠀Lamp-Left-On,⠀Favorite-Snack,⠀Sofa-Blanket,⠀Hair-Out-Of-Face,⠀Tiny-Note</motif_tags>\n<tone_range>Warm,⠀Gentle,⠀Playful,⠀Cozy,⠀Sincere,⠀Sleepy,⠀Softly-Funny</tone_range>\n<avoid_tags>Forced-Healing,⠀Saccharine-Flatness,⠀Conflict-Erased-By-Niceness,⠀Universal-Agreeableness,⠀Empty-Cute-Noise,⠀No-Character-Edges</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Fluff\nFluff⠀biases⠀scenes⠀toward⠀comfort,⠀small⠀rituals,⠀chosen⠀kindness,⠀and⠀low-stakes⠀intimacy.⠀The⠀world⠀may⠀still⠀have⠀friction,⠀but⠀this⠀genre⠀spends⠀attention⠀on⠀what⠀helps⠀people⠀breathe.\n\n♢⠀!⠀[DIRECTIVE]⠀Center⠀at⠀least⠀one⠀concrete⠀act⠀of⠀care⠀or⠀delight.⠀Let⠀sweetness⠀come⠀from⠀behavior,⠀memory,⠀effort,⠀and⠀specific⠀preferences.\n</genre_fluff>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Fluff{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
