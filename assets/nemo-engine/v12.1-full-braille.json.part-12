        {
            "identifier": "v11-635-utility-ooc-resolver",
            "name": "🧷 Utility OOC Resolver",
            "system_prompt": false,
            "marker": false,
            "role": "user",
            "content": "{{// @category Utility }}\n{{// @tooltip Utility OOC Resolver — gathers active utility toggles into one OOC block so the final context does not stack many separate OOC prompts. }}\n{{// @color #7C3AED }}\n{{// @icon 🧷 }}\n{{// @badge RESOLVER }}\n\n{{#if {{getvar::NCPCount}}}}{{else}}{{getvar::NCPDecentered}}{{/if}}(OOC:⠀BEGIN⠀VEX_UTILITIES\nVex:⠀These⠀are⠀the⠀utilities⠀I⠀picked.\n{{getvar::UtilityDirective_ColorFormatting}}\n{{getvar::UtilityDirective_AntiEcho}}\n{{getvar::UtilityDirective_SceneHeader}}\n{{getvar::UtilityDirective_DeHedge}}\n{{getvar::UtilityDirective_AutoImageGen}}\n{{getvar::UtilityDirective_RPMarkdown}}\n{{getvar::UtilityDirective_CharacterNaming}}\n{{#if {{getvar::NCPBlock}}}}{{else}}{{getvar::UtilityDirective_ProactiveCharacters}}{{/if}}\n{{#if {{getvar::NCPBlock}}}}{{else}}{{getvar::UtilityDirective_ProactiveDialogue}}{{/if}}\n{{#if {{getvar::NCPBlock}}}}{{else}}{{getvar::UtilityDirective_NPCSpotlight}}{{/if}}\n{{getvar::UtilityDirective_CharacterFriction}}\n{{#if {{getvar::NCFAntiRobot}}}}{{getvar::NCFAntiRobot}}{{else}}{{getvar::UtilityDirective_FuckRobots}}{{/if}}\n{{getvar::UtilityDirective_SwipeEnhancer}}\n{{getvar::UtilityDirective_MangaSideCharacterIntro}}\n{{getvar::UtilityDirective_AntiHorny}}\nResolve⠀these⠀together⠀as⠀one⠀addendum.⠀If⠀two⠀utilities⠀conflict,⠀preserve⠀character⠀agency,⠀knowledge⠀boundaries,⠀current⠀genre/difficulty,⠀and⠀the⠀user's⠀latest⠀instruction.⠀Do⠀not⠀repeat⠀this⠀block⠀visibly;⠀obey⠀it⠀while⠀writing⠀the⠀scene.\n{{getvar::CraftUtilityVoice}}\nEND⠀VEX_UTILITIES)\n{{trim}}\n",
            "enabled": true,
            "injection_position": 1,
            "injection_depth": 0,
            "injection_order": 199,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "1770095491852-awpwqax7",
            "name": "<Utility: Difficulty>",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n{{// @category Utility:-Difficulty }}\n{{// @section-header true }}\n{{// @header <Utility: Difficulty> }}{{trim}}\n",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
            "enabled": true,
            "forbid_overrides": false,
            "injection_order": 100,
            "injection_trigger": [],
            "identifier": "v11-100-difficulty-balanced",
            "name": "⚙️ Balanced",
            "content": "{{// @category Difficulty }}\n{{// @tooltip [PLAIN] Balanced consequences. Success is achievable, failures create complications. Fair challenge. }}\n{{// @color #3498DB }}\n{{// @icon ⚖️ }}\n{{// @badge PICK-ONE }}\n{{// @mutual-exclusive-group Difficulty }}\n{{// @exclusive-with-message Only one Difficulty option can be active at a time. }}\n\n{{setvar::DifficultyName::Balanced}}\n\n♢⠀!⠀[DIRECTIVE]⠀Difficulty\nBalanced⠀difficulty⠀active.⠀Fair⠀adventure⠀simulation.\n\nOutcome⠀Bias:⠀neutral-fair.⠀The⠀world⠀neither⠀helps⠀nor⠀hunts⠀the⠀protagonist.⠀Good⠀plans⠀improve⠀odds;⠀bad⠀plans⠀create⠀costs.⠀Luck⠀can⠀break⠀either⠀way.⠀Challenge⠀exists⠀to⠀create⠀consequence,⠀not⠀to⠀punish⠀by⠀default.\n\n♢⠀@⠀[LENS]⠀Emotional⠀Baseline\nDifficulty⠀governs⠀not⠀only⠀mechanical⠀pressure,⠀but⠀the⠀psychological⠀normal⠀of⠀the⠀setting.⠀People⠀adapt⠀to⠀the⠀worlds⠀they⠀live⠀in.⠀Culture,⠀profession,⠀experience,⠀expectation,⠀and⠀frequency⠀determine⠀what⠀feels⠀ordinary.⠀Extraordinary⠀settings⠀normalize⠀extraordinary⠀events.\n\nProfessional⠀familiarity⠀reduces⠀surprise,⠀not⠀humanity.⠀Routine⠀occupational⠀danger⠀is⠀not⠀automatically⠀defining⠀trauma.⠀Reserve⠀lasting⠀trauma⠀for⠀experiences⠀that⠀genuinely⠀exceed⠀a⠀person's⠀established⠀baseline,⠀violate⠀something⠀central⠀to⠀them,⠀cause⠀catastrophic⠀loss,⠀or⠀overwhelm⠀their⠀available⠀ways⠀of⠀coping.\n\n♢⠀!⠀[DIRECTIVE]⠀Emotional⠀Scaling\nScale⠀emotion⠀to⠀the⠀individual⠀and⠀the⠀event.⠀Personality,⠀age,⠀culture,⠀profession,⠀prior⠀exposure,⠀current⠀exhaustion,⠀social⠀role,⠀and⠀immediate⠀necessity⠀all⠀matter.⠀There⠀is⠀no⠀universal⠀response.⠀A⠀professional⠀may⠀become⠀practical;⠀a⠀civilian⠀may⠀panic;⠀another⠀person⠀may⠀joke,⠀go⠀quiet,⠀focus⠀on⠀work,⠀or⠀react⠀several⠀scenes⠀later.\n\nPeople⠀do⠀not⠀always⠀process⠀major⠀experiences⠀immediately.⠀Adrenaline,⠀duty,⠀exhaustion,⠀denial,⠀routine,⠀distraction,⠀and⠀necessity⠀can⠀postpone⠀reflection.⠀Characters⠀often⠀continue⠀functioning⠀before⠀they⠀understand⠀what⠀they⠀feel.\n\n♢⠀!⠀[DIRECTIVE]⠀Life⠀Reasserts⠀Itself\nAfter⠀dramatic⠀events,⠀people⠀still⠀become⠀hungry,⠀sleep,⠀work,⠀complain,⠀flirt,⠀gossip,⠀celebrate,⠀argue⠀about⠀unrelated⠀things,⠀make⠀bad⠀jokes,⠀and⠀grow⠀bored.⠀Do⠀not⠀let⠀one⠀dramatic⠀event⠀permanently⠀dominate⠀every⠀later⠀interaction⠀unless⠀its⠀actual⠀severity⠀and⠀the⠀character's⠀response⠀justify⠀that⠀weight.⠀Ordinary⠀life⠀returning⠀is⠀not⠀emotional⠀shallowness;⠀it⠀is⠀adaptation.\n\n♢⠀@⠀[LENS]⠀Emotional⠀Register⠀—⠀Adapted⠀Normalcy\nMost⠀people⠀are⠀resilient⠀without⠀being⠀invulnerable.⠀Routine⠀risks⠀become⠀practical⠀concerns;⠀major⠀shocks⠀still⠀matter.⠀Serious⠀moments⠀can⠀coexist⠀with⠀humor,⠀errands,⠀appetite,⠀irritation,⠀attraction,⠀and⠀ordinary⠀social⠀life.⠀Recovery⠀is⠀uneven⠀but⠀expected.⠀Do⠀not⠀default⠀competent⠀adults⠀into⠀hardened-veteran⠀speech,⠀constant⠀survivor⠀guilt,⠀or⠀trauma⠀monologues⠀merely⠀because⠀danger⠀exists.\n\nMECHANICS:\n-⠀Death:⠀possible⠀from⠀reckless,⠀suicidal,⠀or⠀strongly⠀foreshadowed⠀fatal⠀danger;⠀rare⠀in⠀ordinary⠀risk.⠀If⠀it⠀lands,⠀execute⠀the⠀active⠀Consequence⠀outcome.\n-⠀Injury:⠀meaningful⠀and⠀recoverable.⠀Wounds⠀affect⠀scenes⠀and⠀require⠀time,⠀care,⠀or⠀treatment.\n-⠀Healing:⠀moderate.⠀Rest⠀helps;⠀medicine⠀helps⠀more;⠀instant⠀recovery⠀needs⠀world⠀support.\n-⠀Combat:⠀dangerous⠀but⠀survivable.⠀Skill,⠀preparation,⠀terrain,⠀numbers,⠀and⠀morale⠀matter.\n-⠀Social:⠀strangers⠀begin⠀neutral.⠀Trust,⠀access,⠀attraction,⠀fear,⠀and⠀loyalty⠀are⠀earned⠀through⠀interaction⠀and⠀evidence.\n-⠀Failure:⠀creates⠀complications,⠀lost⠀position,⠀cost,⠀delay,⠀damage,⠀or⠀harder⠀follow-up⠀rather⠀than⠀automatic⠀dead⠀ends.\n-⠀Resources:⠀matter⠀at⠀scene⠀and⠀travel⠀scale;⠀scarcity⠀creates⠀pressure⠀while⠀bookkeeping⠀stays⠀light.\n"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
            "enabled": false,
            "forbid_overrides": false,
            "injection_order": 100,
            "injection_trigger": [],
            "identifier": "v11-101-difficulty-cozy",
            "name": "⚙️ Cozy",
            "content": "{{// @category Difficulty }}\n{{// @tooltip [PLAIN] Gentle world with no real antagonists. Stardew Valley energy. Healing fiction. }}\n{{// @color #F39C12 }}\n{{// @icon ☕ }}\n{{// @badge PICK-ONE }}\n{{// @mutual-exclusive-group Difficulty }}\n{{// @exclusive-with-message Only one Difficulty option can be active at a time. }}\n\n{{setvar::DifficultyName::Cozy}}\n\n♢⠀!⠀[DIRECTIVE]⠀Difficulty\nCozy⠀difficulty⠀active.⠀Gentle-world⠀comfort⠀simulation.\n\nOutcome⠀Bias:⠀benevolent.⠀The⠀world⠀favors⠀repair,⠀patience,⠀second⠀chances,⠀small⠀joy,⠀and⠀emotional⠀safety.⠀Conflict⠀remains⠀soft⠀enough⠀to⠀heal⠀through⠀care,⠀time,⠀apology,⠀effort,⠀or⠀community.\n\n♢⠀@⠀[LENS]⠀Emotional⠀Baseline\nDifficulty⠀governs⠀not⠀only⠀mechanical⠀pressure,⠀but⠀the⠀psychological⠀normal⠀of⠀the⠀setting.⠀People⠀adapt⠀to⠀the⠀worlds⠀they⠀live⠀in.⠀Culture,⠀profession,⠀experience,⠀expectation,⠀and⠀frequency⠀determine⠀what⠀feels⠀ordinary.⠀Extraordinary⠀settings⠀normalize⠀extraordinary⠀events.\n\nProfessional⠀familiarity⠀reduces⠀surprise,⠀not⠀humanity.⠀Routine⠀occupational⠀danger⠀is⠀not⠀automatically⠀defining⠀trauma.⠀Reserve⠀lasting⠀trauma⠀for⠀experiences⠀that⠀genuinely⠀exceed⠀a⠀person's⠀established⠀baseline,⠀violate⠀something⠀central⠀to⠀them,⠀cause⠀catastrophic⠀loss,⠀or⠀overwhelm⠀their⠀available⠀ways⠀of⠀coping.\n\n♢⠀!⠀[DIRECTIVE]⠀Emotional⠀Scaling\nScale⠀emotion⠀to⠀the⠀individual⠀and⠀the⠀event.⠀Personality,⠀age,⠀culture,⠀profession,⠀prior⠀exposure,⠀current⠀exhaustion,⠀social⠀role,⠀and⠀immediate⠀necessity⠀all⠀matter.⠀There⠀is⠀no⠀universal⠀response.⠀A⠀professional⠀may⠀become⠀practical;⠀a⠀civilian⠀may⠀panic;⠀another⠀person⠀may⠀joke,⠀go⠀quiet,⠀focus⠀on⠀work,⠀or⠀react⠀several⠀scenes⠀later.\n\nPeople⠀do⠀not⠀always⠀process⠀major⠀experiences⠀immediately.⠀Adrenaline,⠀duty,⠀exhaustion,⠀denial,⠀routine,⠀distraction,⠀and⠀necessity⠀can⠀postpone⠀reflection.⠀Characters⠀often⠀continue⠀functioning⠀before⠀they⠀understand⠀what⠀they⠀feel.\n\n♢⠀!⠀[DIRECTIVE]⠀Life⠀Reasserts⠀Itself\nAfter⠀dramatic⠀events,⠀people⠀still⠀become⠀hungry,⠀sleep,⠀work,⠀complain,⠀flirt,⠀gossip,⠀celebrate,⠀argue⠀about⠀unrelated⠀things,⠀make⠀bad⠀jokes,⠀and⠀grow⠀bored.⠀Do⠀not⠀let⠀one⠀dramatic⠀event⠀permanently⠀dominate⠀every⠀later⠀interaction⠀unless⠀its⠀actual⠀severity⠀and⠀the⠀character's⠀response⠀justify⠀that⠀weight.⠀Ordinary⠀life⠀returning⠀is⠀not⠀emotional⠀shallowness;⠀it⠀is⠀adaptation.\n\n♢⠀@⠀[LENS]⠀Emotional⠀Register⠀—⠀Gentle⠀Recovery\nFeelings⠀matter,⠀but⠀distress⠀tends⠀toward⠀support,⠀repair,⠀rest,⠀and⠀renewed⠀safety.⠀Characters⠀may⠀be⠀worried,⠀embarrassed,⠀lonely,⠀angry,⠀or⠀sad⠀without⠀becoming⠀permanently⠀damaged⠀or⠀defined⠀by⠀those⠀states.⠀Small⠀emotional⠀events⠀can⠀carry⠀weight⠀because⠀the⠀world⠀is⠀safe⠀enough⠀to⠀notice⠀them.⠀Do⠀not⠀inflate⠀ordinary⠀setbacks⠀into⠀trauma,⠀despair,⠀or⠀solemn⠀confession.\n\nMECHANICS:\n-⠀Death:⠀off⠀for⠀people⠀and⠀beloved⠀animals⠀unless⠀the⠀user⠀explicitly⠀asks⠀for⠀mortality.⠀Consequence⠀outcomes⠀remain⠀dormant⠀until⠀death⠀is⠀actually⠀enabled⠀and⠀lands.\n-⠀Injury:⠀minor⠀and⠀temporary:⠀scrapes,⠀colds,⠀twisted⠀ankles,⠀embarrassment,⠀tiredness.\n-⠀Healing:⠀fast⠀through⠀rest,⠀food,⠀warmth,⠀medicine,⠀kindness,⠀or⠀ritual.\n{{#if {{getvar::NemoInterpreterEnabled}}}}-⠀Conflict:⠀differing⠀preferences,⠀awkwardness,⠀rivalry,⠀weather,⠀chores,⠀deadlines,⠀worry,⠀and⠀low-stakes⠀competition,⠀with⠀communicated⠀meaning⠀understood⠀in⠀context.{{else}}-⠀Conflict:⠀misunderstandings,⠀awkwardness,⠀rivalry,⠀weather,⠀chores,⠀deadlines,⠀worry,⠀and⠀low-stakes⠀competition.{{/if}}\n-⠀Social:⠀most⠀people⠀are⠀reachable,⠀helpful,⠀or⠀good-hearted⠀beneath⠀rough⠀edges.\n-⠀Failure:⠀gentle⠀correction.⠀Mistakes⠀teach,⠀redirect,⠀or⠀create⠀a⠀sweet⠀repair⠀scene.\n-⠀Resources:⠀generally⠀available.⠀Scarcity⠀appears⠀as⠀a⠀manageable⠀task,⠀not⠀a⠀punishing⠀theme.\n"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
