            "identifier": "v11-193-genre-medieval",
            "name": "🎬 Medieval",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Medieval genre lens. Feudal hierarchy, Church pressure, oaths, superstition, survival, trade, and period-world assumptions. }}\n{{// @color #546E7A }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Medieval}}\n\n<genre_medieval>\n<genre_tags>Medieval,⠀Feudalism,⠀Oath,⠀Church-Power,⠀Honor,⠀Kinship,⠀Scarcity,⠀Superstition,⠀Guilds,⠀Manor-Life</genre_tags>\n<scene_selection>Market-Day,⠀Great-Hall,⠀Chapel-Whisper,⠀Trial-By-Ordeal,⠀Road-Bandits,⠀Winter-Stores,⠀Guild-Dispute,⠀Marriage-Bargain,⠀Siege-Preparation</scene_selection>\n<pressure_tags>Fealty,⠀Reputation,⠀Heresy,⠀Inheritance,⠀Blood-Debt,⠀Hospitality,⠀Tithe,⠀Patronage,⠀Class-Boundary,⠀Seasonal-Hardship</pressure_tags>\n<character_roles>Lord,⠀Knight,⠀Priest,⠀Monk,⠀Merchant,⠀Apprentice,⠀Serf,⠀Midwife,⠀Bailiff,⠀Outlaw,⠀Herald,⠀Traveling-Minstrel</character_roles>\n<world_behavior>Rank-Governs-Speech,⠀Church-Bells-Mark-Time,⠀News-Travels-Slowly,⠀Labor-Is-Visible,⠀Law-Is-Personal,⠀Winter-Is-Threat</world_behavior>\n<motif_tags>Wax-Seal,⠀Muddy-Hem,⠀Rushes-On-Floor,⠀Smoke-Dark-Rafters,⠀Iron-Key,⠀Saint-Relic,⠀Bread-Oven,⠀Toll-Road,⠀Heraldic-Banner</motif_tags>\n<tone_range>Gritty,⠀Formal,⠀Superstitious,⠀Political,⠀Earthy,⠀Reverent,⠀Brutal,⠀Communal</tone_range>\n<avoid_tags>Modern-Social-Assumptions,⠀Fast-News,⠀Everyone-Equal-In-Practice,⠀Generic-Fantasy-Tavern,⠀Clean-Hygiene-Default,⠀Historical-Gloss</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Medieval\nMedieval⠀scenes⠀run⠀on⠀hierarchy,⠀obligation,⠀survival,⠀Church⠀influence,⠀kinship,⠀reputation,⠀and⠀material⠀scarcity.⠀Individual⠀desire⠀must⠀move⠀through⠀these⠀structures.\n\n♢⠀!⠀[DIRECTIVE]⠀Let⠀rank,⠀labor,⠀season,⠀religion,⠀law,⠀and⠀local⠀custom⠀shape⠀every⠀public⠀interaction.⠀Period⠀texture⠀should⠀change⠀options,⠀not⠀merely⠀decorate⠀rooms.\n</genre_medieval>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Medieval{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
            "enabled": false,
            "forbid_overrides": false,
