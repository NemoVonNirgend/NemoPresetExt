            "identifier": "v11-191-genre-high-fantasy",
            "name": "🎬 High Fantasy",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] High Fantasy genre lens. Oaths, magic, dynasties, ruins, mythic scale, and personal cost under ancient pressure. }}\n{{// @color #9B59B6 }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + High Fantasy}}\n\n<genre_high_fantasy>\n<genre_tags>High-Fantasy,⠀Mythic-Scale,⠀Magic,⠀Oaths,⠀Bloodlines,⠀Ancient-History,⠀Ruins,⠀Prophecy-Pressure,⠀Kingdoms</genre_tags>\n<scene_selection>Court-Assemblies,⠀Rituals,⠀Ancient-Roads,⠀Council-Fire,⠀Siege-Edge,⠀Lost-Temple,⠀Oathbreaking,⠀Relic-Discovery,⠀Border-Crossing</scene_selection>\n<pressure_tags>Duty-Vs-Desire,⠀Legacy,⠀Sacred-Law,⠀Costly-Magic,⠀Political-Betrayal,⠀Divine-Silence,⠀Chosen-Refusal,⠀Crown-Burden</pressure_tags>\n<character_roles>Reluctant-Heir,⠀Oathbound-Knight,⠀Exiled-Mage,⠀Heretic-Priest,⠀Loyal-Betrayer,⠀Commoner-With-Leverage,⠀Ancient-Witness</character_roles>\n<world_behavior>History-Presses-On-Present,⠀Magic-Has-Cost,⠀Titles-Carry-Debt,⠀Songs-And-Rumors-Travel,⠀Ruins-Have-Memory</world_behavior>\n<motif_tags>Old-Stone,⠀Broken-Banners,⠀Star-Maps,⠀Sealed-Gates,⠀Dragon-Bones,⠀Crown-Weight,⠀Candlelit-Oaths,⠀Road-Dust-On-Ceremony</motif_tags>\n<tone_range>Wondrous,⠀Grave,⠀Heroic,⠀Treacherous,⠀Reverent,⠀Dangerous,⠀Awe-Struck,⠀Intimate-Under-Scale</tone_range>\n<avoid_tags>Empty-Grandiosity,⠀Prophecy-Replacing-Choice,⠀Magic-Without-Cost,⠀Everyone-Speaks-Formal,⠀Lore-Dump-Pageantry,⠀Easy-Triumph</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀High⠀Fantasy\nHigh⠀Fantasy⠀treats⠀history,⠀oath,⠀power,⠀landscape,⠀and⠀magic⠀as⠀active⠀pressures.⠀Scale⠀matters⠀only⠀when⠀it⠀touches⠀personal⠀choice.\n\n♢⠀!⠀[DIRECTIVE]⠀Let⠀grandeur⠀arise⠀through⠀obligation,⠀memory,⠀danger,⠀ritual,⠀and⠀cost.⠀Magic,⠀titles,⠀bloodlines,⠀and⠀relics⠀should⠀change⠀what⠀people⠀can⠀do⠀and⠀what⠀they⠀owe.\n</genre_high_fantasy>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}High⠀Fantasy{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
