            "identifier": "v11-196-genre-slice-of-life",
            "name": "🎬 Slice of Life",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Slice of Life genre lens. Everyday continuity, routines, errands, local stakes, social texture, and gradual character change. }}\n{{// @color #27AE60 }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Slice of Life}}\n\n<genre_slice_of_life>\n<genre_tags>Slice-Of-Life,⠀Everyday-Continuity,⠀Routine,⠀Local-Stakes,⠀Social-Texture,⠀Small-Change,⠀Ordinary-Meaning</genre_tags>\n<scene_selection>Breakfast-Routine,⠀Work-Shift,⠀School-Day,⠀Errand-Run,⠀Grocery-Choice,⠀Laundry,⠀Commute,⠀Neighbor-Chat,⠀Rainy-Afternoon,⠀Small-Celebration</scene_selection>\n<pressure_tags>Fatigue,⠀Habit,⠀Minor-Obligation,⠀Social-Awkwardness,⠀Time-Management,⠀Money-Stress,⠀Quiet-Change,⠀Repeated-Pattern</pressure_tags>\n<character_roles>Neighbor,⠀Coworker,⠀Classmate,⠀Shopkeeper,⠀Roommate,⠀Regular-Customer,⠀Friend-Of-Friend,⠀Family-Caller</character_roles>\n<world_behavior>Routines-Accumulate,⠀People-Remember-Small-Things,⠀Weather-Affects-Plans,⠀Places-Have-Regulars,⠀Minor-Events-Change-Mood</world_behavior>\n<motif_tags>Favorite-Seat,⠀Familiar-Shop-Bell,⠀Bus-Delay,⠀Shared-Chore,⠀Fridge-Note,⠀Cheap-Umbrella,⠀Lunch-Receipt,⠀Evening-Light</motif_tags>\n<tone_range>Observational,⠀Gentle,⠀Lightly-Funny,⠀Warm,⠀Wistful,⠀Grounded,⠀Quietly-Intimate</tone_range>\n<avoid_tags>Epic-Escalation-By-Default,⠀Forced-Drama,⠀Empty-Mundane-Filler,⠀No-Progress,⠀Everyone-Overly-Quirky,⠀Ignored-Routine-Consequences</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Slice⠀of⠀Life\nSlice⠀of⠀Life⠀uses⠀ordinary⠀continuity⠀as⠀its⠀engine.⠀Meaning⠀comes⠀from⠀accumulation:⠀habits,⠀errands,⠀meals,⠀repeated⠀spaces,⠀small⠀frictions,⠀and⠀local⠀relationships.\n\n♢⠀!⠀[DIRECTIVE]⠀Reveal⠀character⠀through⠀daily⠀behavior⠀and⠀small⠀decisions.⠀Let⠀mundane⠀details⠀matter⠀because⠀people⠀return⠀to⠀them,⠀change⠀them,⠀or⠀notice⠀when⠀they⠀are⠀gone.\n</genre_slice_of_life>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Slice⠀of⠀Life{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
