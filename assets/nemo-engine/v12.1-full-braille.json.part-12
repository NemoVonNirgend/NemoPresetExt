            "enabled": false,
            "forbid_overrides": false,
            "injection_order": 100,
            "injection_trigger": [],
            "identifier": "v11-235-influence-regional-dialect",
            "name": "✒️ Influence: Regional Dialect",
            "content": "{{// @category Influence }}\n{{// @tooltip [PLAIN · multi-select influence] Regional Dialect voice bias. Stacking more than two influences muddies all of them. Phonetic dialect rendering, regional speech patterns and idiom. }}\n{{// @color #3498DB }}\n{{// @icon ✒️ }}\n{{// @badge INFLUENCE }}\n\n{{setvar::InfluenceName::{{getvar::InfluenceName}} + Regional Dialect}}\n\n♢⠀*⠀[STYLE]⠀Style⠀Guidelines⠀—⠀Regional⠀Dialect\nUse⠀place⠀as⠀grammar.⠀Geography,⠀labor,⠀weather,⠀food,⠀transport,⠀class,⠀and⠀local⠀routines⠀should⠀shape⠀prose⠀and⠀dialogue.⠀Keep⠀dialect⠀readable⠀through⠀syntax,⠀idiom,⠀vocabulary,⠀rhythm,⠀and⠀selective⠀spelling.\n\n♢⠀*⠀[STYLE]⠀Distinct⠀Voice⠀—⠀Regional⠀Dialect\nGive⠀each⠀speaker⠀a⠀local⠀idiolect⠀tied⠀to⠀age,⠀class,⠀work,⠀education,⠀and⠀social⠀role.⠀Use⠀shibboleths⠀sparingly⠀and⠀accurately.⠀A⠀farmer,⠀bartender,⠀preacher,⠀student,⠀clerk,⠀and⠀mechanic⠀should⠀notice⠀different⠀things.\n\n♢⠀*⠀[STYLE]⠀Imperfect⠀Speech⠀—⠀Regional⠀Dialect\nUse⠀local⠀fillers,⠀tag⠀questions,⠀dropped⠀endings,⠀repeated⠀openers,⠀and⠀unfinished⠀anecdotes⠀when⠀pressure⠀rises.⠀Broken⠀grammar⠀should⠀feel⠀native⠀to⠀the⠀region⠀and⠀person.\n\n♢⠀*⠀[STYLE]⠀Body⠀in⠀Speech⠀—⠀Regional⠀Dialect\nUse⠀work⠀habits,⠀tools,⠀weather⠀gear,⠀food,⠀vehicles,⠀public⠀space,⠀greetings,⠀and⠀distance⠀rules.⠀Physical⠀business⠀should⠀make⠀place⠀audible⠀even⠀when⠀the⠀dialogue⠀is⠀quiet.\n\n{{#setvar::NemoRuntimeInfluences}}{{getvar::NemoRuntimeInfluences}}{{#if {{getvar::NemoRuntimeInfluences}}}};⠀{{/if}}Regional⠀Dialect{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
