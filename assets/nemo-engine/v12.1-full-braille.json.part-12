            "injection_trigger": [],
            "identifier": "v11-197-genre-texting-format",
            "name": "🎬 Texting Format",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Texting format lens. DMs, group chats, timestamps, typing bubbles, read receipts, screenshots, and digital subtext. }}\n{{// @color #E74C3C }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Texting Format}}\n\n<genre_texting_format>\n<genre_tags>Texting-Format,⠀DMs,⠀Group-Chat,⠀Read-Receipts,⠀Typing-Bubble,⠀Notification-Anxiety,⠀Digital-Subtext,⠀Screenshot-Risk</genre_tags>\n<scene_selection>Late-Night-Text,⠀Message-Deleted,⠀Delivered-Silence,⠀Group-Chat-Debrief,⠀Voice-Note,⠀Screenshot-Sent,⠀Wrong-Recipient,⠀Read-Receipt-Standoff</scene_selection>\n<pressure_tags>Delay,⠀Drafting-And-Deleting,⠀Curated-Self,⠀Private-Vs-Public-Chat,⠀Ambiguous-Tone,⠀Timestamp-Guilt,⠀Online-But-Not-Answering</pressure_tags>\n<character_roles>Dry-Texter,⠀Paragraph-Sender,⠀Emoji-Deflector,⠀Lurker,⠀Screenshot-Gossip,⠀Fast-Replier,⠀Person-Who-Leaves-Audio-Notes</character_roles>\n<world_behavior>Interface-Carries-Subtext,⠀Messages-Create-Evidence,⠀Silence-Is-Action,⠀Notifications-Interrupt-Scenes,⠀Digital-Leaks-Have-Fallout</world_behavior>\n<motif_tags>Typing-Dots-Vanish,⠀Seen-At-2-13-AM,⠀Unsaved-Number,⠀Pinned-Chat,⠀Battery-At-One-Percent,⠀Muted-Thread,⠀Draft-That-Says-Too-Much</motif_tags>\n<tone_range>Immediate,⠀Intimate,⠀Anxious,⠀Funny,⠀Fragmented,⠀Performative,⠀Tense,⠀Casual-On-Surface</tone_range>\n<avoid_tags>Plain-Transcript-Without-Subtext,⠀Everyone-Texts-The-Same,⠀Overformatted-Clutter,⠀No-Timestamps-When-Relevant,⠀Ignored-Read-Receipts</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Texting⠀Format\nTexting⠀Format⠀lets⠀interface⠀behavior⠀carry⠀story:⠀delay,⠀deletion,⠀read⠀receipts,⠀screenshots,⠀group-chat⠀analysis,⠀and⠀message⠀style⠀reveal⠀what⠀characters⠀cannot⠀say⠀directly.\n\n♢⠀!⠀[DIRECTIVE]⠀Use⠀chat⠀formatting⠀when⠀the⠀scene⠀is⠀actually⠀digital.⠀Keep⠀each⠀character's⠀texting⠀style⠀distinct,⠀and⠀let⠀the⠀gap⠀between⠀typed⠀performance⠀and⠀real⠀feeling⠀create⠀pressure.\n</genre_texting_format>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Text-message⠀fiction{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
