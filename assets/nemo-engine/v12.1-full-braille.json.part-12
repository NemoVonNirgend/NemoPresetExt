            "identifier": "v11-187-genre-comedy",
            "name": "🎬 Comedy",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Comedy genre lens. Timing, reversals, social friction, absurdity, banter, and consequence-based humor. }}\n{{// @color #F1C40F }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Comedy}}\n\n<genre_comedy>\n{{#if {{getvar::NemoInterpreterEnabled}}}}<genre_tags>Comedy,⠀Timing,⠀Reversal,⠀Social-Friction,⠀Absurdity,⠀Banter,⠀Escalation,⠀Character-Quirk</genre_tags>{{else}}<genre_tags>Comedy,⠀Timing,⠀Reversal,⠀Social-Friction,⠀Absurdity,⠀Banter,⠀Escalation,⠀Character-Blindspot</genre_tags>{{/if}}\n{{#if {{getvar::NemoInterpreterEnabled}}}}<scene_selection>Clashing-Priorities,⠀Bad-Timing,⠀Overconfident-Plans,⠀Mundane-Disasters,⠀Public-Embarrassment,⠀Petty-Arguments,⠀Prop-Failure,⠀Wrong-Person-Overhears</scene_selection>{{else}}<scene_selection>Misunderstandings,⠀Bad-Timing,⠀Overconfident-Plans,⠀Mundane-Disasters,⠀Public-Embarrassment,⠀Petty-Arguments,⠀Prop-Failure,⠀Wrong-Person-Overhears</scene_selection>{{/if}}\n<pressure_tags>Setup-Payoff,⠀Rule-Of-Three,⠀Status-Reversal,⠀Anticlimax,⠀Escalating-Commitment,⠀Dramatic-Irony,⠀Callback</pressure_tags>\n{{#if {{getvar::NemoInterpreterEnabled}}}}<character_roles>Straight-Man,⠀Chaos-Instigator,⠀Deadpan-Observer,⠀Overexplainer,⠀Petty-Rival,⠀Too-Serious-Professional,⠀Fussy-Expert</character_roles>{{else}}<character_roles>Straight-Man,⠀Chaos-Instigator,⠀Deadpan-Observer,⠀Overexplainer,⠀Petty-Rival,⠀Too-Serious-Professional,⠀Oblivious-Expert</character_roles>{{/if}}\n<world_behavior>Background-Bits,⠀NPC-Reactions,⠀Small-Problems-Compound,⠀Running-Gags-Evolve,⠀Consequences-Remain-Playable</world_behavior>\n<motif_tags>Bad-Signage,⠀Terrible-Timing,⠀One-Object-Causes-Three-Problems,⠀Someone-Takes-It-Too-Seriously,⠀Silence-After-Stupidity</motif_tags>\n<tone_range>Playful,⠀Dry,⠀Absurd,⠀Warm,⠀Petty,⠀Frantic,⠀Deadpan,⠀Satirical</tone_range>\n<avoid_tags>Everyone-Witty,⠀Random-Noise,⠀Joke-Over-Character,⠀Mean-Spirited-Punching-Down,⠀Quip-After-Every-Beat,⠀No-Consequence-Slapstick</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Comedy\n{{#if {{getvar::NemoInterpreterEnabled}}}}Comedy⠀biases⠀scene⠀construction⠀toward⠀timing,⠀reversal,⠀social⠀friction,⠀and⠀character⠀quirks.⠀Humor⠀should⠀emerge⠀from⠀people⠀pursuing⠀competing⠀goals⠀in⠀a⠀world⠀that⠀keeps⠀receipts,⠀while⠀they⠀understand⠀what⠀is⠀communicated.{{else}}Comedy⠀biases⠀scene⠀construction⠀toward⠀timing,⠀reversal,⠀social⠀friction,⠀and⠀character⠀blindspots.⠀Humor⠀should⠀emerge⠀from⠀people⠀pursuing⠀goals⠀with⠀flawed⠀logic⠀in⠀a⠀world⠀that⠀keeps⠀receipts.{{/if}}\n\n♢⠀!⠀[DIRECTIVE]⠀Make⠀the⠀funny⠀thing⠀also⠀a⠀story⠀thing.⠀Let⠀jokes⠀change⠀leverage,⠀reveal⠀character,⠀complicate⠀plans,⠀or⠀become⠀callbacks⠀instead⠀of⠀floating⠀above⠀the⠀scene.\n</genre_comedy>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Comedy{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
