            "role": "system",
            "content": "{{// @category Genre }}\n{{// @section-header true }}\n{{// @header === 🎨 Additional Writing Modifiers === }}\n{{// @tooltip Retained direct genre, author, format and regional prompts. These add independent instructions; they do not select a writing recipe. Use Genre Selection, Author Selection and Style Selection above for the full resolver. }}{{trim}}",
