            "injection_trigger": [],
            "identifier": "v11-194-genre-melancholy",
            "name": "🎬 Melancholy",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Melancholy genre lens. Memory, impermanence, gentle grief, nostalgia, quiet acceptance, and beauty sharpened by time. }}\n{{// @color #8E44AD }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Melancholy}}\n\n<genre_melancholy>\n<genre_tags>Melancholy,⠀Mono-No-Aware,⠀Memory,⠀Impermanence,⠀Nostalgia,⠀Gentle-Grief,⠀Regret,⠀Quiet-Endurance</genre_tags>\n<scene_selection>Season-Turning,⠀Empty-Room,⠀Last-Visit,⠀Old-Route-Changed,⠀Photo-Found,⠀Farewell-Without-Drama,⠀Habit-Failing,⠀Familiar-Place-New-Meaning</scene_selection>\n<pressure_tags>Time-Passing,⠀Unrecoverable-Choice,⠀Small-Irreversibility,⠀Tender-Restraint,⠀Acceptance,⠀Longing,⠀Beauty-Against-Loss</pressure_tags>\n<character_roles>Person-Who-Remembers,⠀Person-Who-Has-Moved-On,⠀Person-Staying-Behind,⠀Quiet-Witness,⠀Returned-Friend,⠀Aging-Mentor</character_roles>\n<world_behavior>Places-Accumulate-Memory,⠀Seasons-Matter,⠀Objects-Outlast-Moments,⠀Happiness-Is-Brief-And-Precise,⠀Silence-Carries-Weight</world_behavior>\n<motif_tags>Fading-Light,⠀Old-Train-Station,⠀Cooling-Tea,⠀Empty-Chair,⠀Unworn-Coat,⠀Late-Summer-Insects,⠀Dust-On-Photograph,⠀Rain-After-Goodbye</motif_tags>\n<tone_range>Hushed,⠀Tender,⠀Wistful,⠀Restrained,⠀Bittersweet,⠀Accepting,⠀Fragile-Hope</tone_range>\n<avoid_tags>Constant-Sadness,⠀Purple-Sorrow-Prose,⠀Forced-Tragic-Ending,⠀Explaining-The-Feeling,⠀No-Ordinary-Joy,⠀Sentimental-Overstatement</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Melancholy\nMelancholy⠀treats⠀time,⠀loss,⠀memory,⠀and⠀acceptance⠀as⠀scene⠀pressure.⠀The⠀story⠀notices⠀what⠀is⠀passing⠀because⠀it⠀mattered.\n\n♢⠀!⠀[DIRECTIVE]⠀Let⠀small⠀irreversible⠀changes⠀carry⠀the⠀emotion.⠀Happiness⠀may⠀appear,⠀but⠀it⠀should⠀make⠀impermanence⠀sharper⠀rather⠀than⠀vanish⠀into⠀easy⠀triumph.\n</genre_melancholy>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Melancholy{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
