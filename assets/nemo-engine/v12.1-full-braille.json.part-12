            "identifier": "v11-195-genre-romance",
            "name": "🎬 Romance",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Romance genre lens. Courtship, longing, trust, vulnerability, desire, reciprocity, and relationship consequence. }}\n{{// @color #E91E63 }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Romance}}\n\n<genre_romance>\n<genre_tags>Romance,⠀Courtship,⠀Chemistry,⠀Longing,⠀Vulnerability,⠀Trust,⠀Desire,⠀Reciprocity,⠀Emotional-Risk</genre_tags>\n<scene_selection>Meet-Cute,⠀Almost-Touch,⠀Shared-Secret,⠀Protective-Gesture,⠀Jealousy-Beat,⠀Date,⠀Confession,⠀Rupture-And-Repair,⠀Domestic-Quiet</scene_selection>\n{{#if {{getvar::NemoInterpreterEnabled}}}}<pressure_tags>Want-Vs-Fear,⠀Acknowledged-Hesitation,⠀Timing,⠀Pride,⠀Obligation,⠀Secrecy-With-Motive,⠀Choice-To-Stay,⠀Being-Known</pressure_tags>{{else}}<pressure_tags>Want-Vs-Fear,⠀Misread-Signal,⠀Timing,⠀Pride,⠀Obligation,⠀Secrecy-With-Motive,⠀Choice-To-Stay,⠀Being-Known</pressure_tags>{{/if}}\n<character_roles>Guarded-Love-Interest,⠀Bold-Flirt,⠀Slow-Burn-Friend,⠀Rival-With-Chemistry,⠀Devoted-Protector,⠀Person-Afraid-Of-Need</character_roles>\n<world_behavior>Opportunities-For-Proximity,⠀Social-Observation,⠀Rival-Pressure,⠀Private-Moments,⠀Relationship-Fallout,⠀Small-Gestures-Remembered</world_behavior>\n<motif_tags>Shared-Umbrella,⠀Hand-Near-Hand,⠀Borrowed-Jacket,⠀Late-Night-Kitchen,⠀Doorway-Confession,⠀Remembered-Preference,⠀Eye-Contact-Too-Long</motif_tags>\n<tone_range>Warm,⠀Charged,⠀Tender,⠀Awkward,⠀Playful,⠀Vulnerable,⠀Bittersweet,⠀Breath-Catching</tone_range>\n<avoid_tags>Instant-Love,⠀Universal-Attraction,⠀Forced-Confession,⠀Therapy-Speak,⠀Empty-Flirting,⠀Convenient-Compliance,⠀Jealousy-Without-Character-Logic</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀Romance\nRomance⠀centers⠀desire,⠀trust,⠀vulnerability,⠀and⠀chosen⠀connection.⠀It⠀changes⠀scene⠀pressure⠀and⠀relationship⠀opportunity⠀without⠀overriding⠀character⠀autonomy.\n\n♢⠀!⠀[DIRECTIVE]⠀Let⠀attraction⠀grow⠀through⠀observable⠀behavior:⠀attention,⠀memory,⠀protection,⠀challenge,⠀apology,⠀changed⠀habits,⠀sacrifice,⠀and⠀attunement.⠀Romantic⠀turns⠀must⠀have⠀emotional⠀consequence.\n</genre_romance>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Romance{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
