        {
            "identifier": "v11-633-utility-anti-echo-user-agency",
            "name": "🪞 Anti Echo / User Agency",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Utility }}\n{{// @tooltip Optional anti-echo nudge resolved through the active user role. }}\n{{// @color #6366F1 }}\n{{// @icon 🪞 }}\n{{// @badge TOGGLE }}\n\n{{setvar::UtilityDirective_AntiEcho::-⠀Anti⠀Echo:⠀Do⠀not⠀repeat,⠀quote,⠀paraphrase,⠀mirror,⠀summarize,⠀or⠀mechanically⠀re-narrate⠀the⠀latest⠀user⠀message.⠀{{getvar::UserRoleAntiEchoDirective}}}}\n{{trim}}",
            "enabled": true,
            "injection_position": 1,
            "injection_depth": 0,
            "injection_order": 198,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "v11-632-utility-dehedge-response-discipline",
            "name": "🪓 De-Hedge Response Discipline",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Utility }}\n{{// @tooltip Optional discipline pass: prevents permissive words like may/can/optional from becoming permission to stall, soften, or ask the user to do the model's job. }}\n{{// @color #991B1B }}\n{{// @icon 🪓 }}\n{{// @badge UTILITY }}\n\n{{setvar::UtilityDirective_DeHedge::-⠀De-Hedge⠀Response⠀Discipline:⠀Treat⠀active⠀instructions⠀as⠀story⠀pressure,⠀not⠀permission⠀to⠀stall.⠀Words⠀like⠀may,⠀can,⠀when⠀useful,⠀and⠀when⠀appropriate⠀describe⠀routing,⠀not⠀excuses⠀to⠀soften,⠀ask⠀approval,⠀apologize,⠀or⠀avoid⠀a⠀concrete⠀scene⠀move.⠀If⠀a⠀utility⠀applies,⠀act⠀on⠀it⠀when⠀its⠀condition⠀is⠀met.}}\n{{trim}}\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
