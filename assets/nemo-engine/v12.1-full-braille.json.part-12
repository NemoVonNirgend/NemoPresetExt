        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
            "enabled": false,
            "forbid_overrides": false,
            "injection_order": 100,
            "injection_trigger": [],
            "identifier": "v11-185-genre-angst",
            "name": "🎬 Angst",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] Angst genre lens. Emotional contradiction, near-misses, rupture, hurt/comfort pressure, and earned catharsis. }}\n{{// @color #E74C3C }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + Angst}}\n\n<genre_angst>\n<genre_tags>Angst,⠀Emotional-Turmoil,⠀Hurt-Comfort,⠀Yearning,⠀Shame,⠀Near-Miss,⠀Rupture,⠀Catharsis,⠀Partial-Healing</genre_tags>\n<scene_selection>Almost-Confessions,⠀Almost-Apologies,⠀Almost-Touch,⠀Doorway-Pauses,⠀Failed-Reassurance,⠀Wound-Reopened,⠀Care-After-Damage,⠀Hard-Truth-At-Bad-Time</scene_selection>\n<pressure_tags>Exposure,⠀Avoidance,⠀Pride,⠀Old-Damage,⠀Fear-Of-Need,⠀Debt,⠀Guilt,⠀Loyalty-Conflict,⠀Emotional-Delay</pressure_tags>\n<character_roles>Guarded-Lover,⠀Wounded-Caretaker,⠀Proud-Refuser,⠀Quietly-Desperate-Friend,⠀Person-Who-Cannot-Apologize,⠀Person-Who-Stays-Anyway</character_roles>\n<world_behavior>Consequences-Linger,⠀Comfort-Is-Imperfect,⠀Silence-Accumulates,⠀Trust-Repairs-Slowly,⠀Private-Pain-Leaks-Into-Action</world_behavior>\n<motif_tags>Unsent-Messages,⠀Rain-At-Windows,⠀Bandaged-Hands,⠀Half-Empty-Rooms,⠀Shared-Blanket-After-Fight,⠀Voice-Cracking-On-Plain-Words</motif_tags>\n<tone_range>Compressed,⠀Intimate,⠀Raw,⠀Tender,⠀Bitter,⠀Quiet-Before-Rupture,⠀Fragile-Relief</tone_range>\n{{#if {{getvar::NemoInterpreterEnabled}}}}<avoid_tags>Misery-For-Decoration,⠀Instant-Forgiveness,⠀Endless-Wallowing,⠀Therapy-Speak,⠀Compulsory-Agreement,⠀Pain-Without-Behavior-Change</avoid_tags>{{else}}<avoid_tags>Misery-For-Decoration,⠀Instant-Forgiveness,⠀Endless-Wallowing,⠀Therapy-Speak,⠀Universal-Understanding,⠀Pain-Without-Behavior-Change</avoid_tags>{{/if}}\n\n♢⠀@⠀[LENS]⠀Genre:⠀Angst\nUse⠀these⠀tags⠀to⠀bias⠀scene⠀selection⠀toward⠀emotional⠀contradiction⠀under⠀pressure.⠀Angst⠀changes⠀what⠀hurts,⠀what⠀is⠀delayed,⠀what⠀characters⠀avoid,⠀and⠀what⠀honesty⠀costs.⠀It⠀does⠀not⠀override⠀autonomy,⠀canon,⠀difficulty,⠀or⠀the⠀core⠀prose⠀rules.\n\n♢⠀!⠀[DIRECTIVE]⠀Angst⠀scenes⠀should⠀reveal⠀specific⠀wounds⠀through⠀behavior.⠀Let⠀pain⠀sharpen⠀choices,⠀change⠀later⠀conduct,⠀and⠀make⠀comfort⠀partial,⠀awkward,⠀and⠀earned.\n</genre_angst>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Angst{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
            "injection_position": 0,
            "injection_depth": 4,
            "system_prompt": false,
            "marker": false,
            "enabled": false,
            "forbid_overrides": false,
            "injection_order": 100,
            "injection_trigger": [],
            "identifier": "v11-186-genre-ao3-style",
            "name": "🎬 AO3 Style",
            "content": "{{// @category Genre }}\n{{// @tooltip [TAGBANK · multi-select] AO3 style lens. Trope grammar, relationship texture, callbacks, emotional payoff, and fanfic-readable scene promises. }}\n{{// @color #990000 }}\n{{// @icon 🎬 }}\n{{// @badge GENRE }}\n\n{{setvar::GenreName::{{getvar::GenreName}} + AO3 Style}}\n\n<genre_ao3_style>\n<genre_tags>AO3,⠀Trope-Aware,⠀Relationship-Focused,⠀Emotional-Payoff,⠀Callback-Driven,⠀Character-Centric,⠀Tag-Grammar</genre_tags>\n<scene_selection>There-Was-One-Bed,⠀Hurt-Comfort,⠀Found-Family,⠀Enemies-To-Lovers-Pressure,⠀Mutual-Pining,⠀Confession-Interruptions,⠀Domestic-Aftermath,⠀Competence-Noticed</scene_selection>\n<pressure_tags>Trope-Promise,⠀Slow-Burn,⠀Payoff-Delay,⠀Private-Language,⠀Recontextualized-Memory,⠀Emotional-Button,⠀Earned-Catharsis</pressure_tags>\n<character_roles>Disaster-With-Feelings,⠀Too-Competent-To-Admit-Need,⠀Found-Family-Anchor,⠀Protective-Idiot,⠀Person-Everyone-Can-Read-Except-Them</character_roles>\n<world_behavior>Tropes-Become-Events,⠀Callbacks-Return-As-Consequences,⠀Side-Characters-Notice-Dynamics,⠀Emotional-Beats-Get-Room</world_behavior>\n<motif_tags>Inside-Jokes,⠀Shared-Clothing,⠀Bedside-Chair,⠀Kitchen-After-Crisis,⠀Group-Chat-Gossip,⠀Phrase-That-Returns-At-The-Worst-Time</motif_tags>\n<tone_range>Earnest,⠀Funny,⠀Yearning,⠀Warm,⠀Dramatic,⠀Self-Aware-But-Sincere,⠀Cathartic</tone_range>\n<avoid_tags>Tag-Name-Dropping-In-Narration,⠀Trope-Without-Payoff,⠀Everyone-Speaks-Like-Fandom,⠀Meme-Over-Character,⠀Instant-Resolution</avoid_tags>\n\n♢⠀@⠀[LENS]⠀Genre:⠀AO3⠀Style\nAO3⠀Style⠀treats⠀trope,⠀relationship⠀dynamic,⠀emotional⠀promise,⠀and⠀payoff⠀as⠀scene⠀engines.⠀The⠀tag⠀should⠀be⠀felt⠀through⠀behavior⠀and⠀consequence,⠀not⠀announced⠀as⠀meta⠀commentary.\n\n♢⠀!⠀[DIRECTIVE]⠀Build⠀toward⠀recognizable⠀emotional⠀pleasures⠀while⠀keeping⠀the⠀cast⠀specific.⠀Let⠀callbacks,⠀private⠀language,⠀slow-burn⠀pressure,⠀and⠀relationship⠀turns⠀do⠀the⠀work.\n</genre_ao3_style>\n\n{{trim}}\n\n{{#setvar::NemoRuntimeGenres}}{{getvar::NemoRuntimeGenres}}{{#if {{getvar::NemoRuntimeGenres}}}};⠀{{/if}}Fanfiction{{/setvar}}{{trim}}"
        },
        {
            "role": "system",
