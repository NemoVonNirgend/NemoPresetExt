            "identifier": "prose-convention-resolver",
            "name": "⚖️ Prose Convention Resolver",
            "content": "{{// @category Prose-Convention }}\n{{// @tooltip Emits the selected Prose Convention as an authoritative block after all style and influence modules. Keep enabled. Every option writes the same complete slots and one authoritative ProseConventionMode value; the resolver emits only the final selected state. }}\n{{// @color #2C3E50 }}\n{{// @icon ⚖️ }}\n{{// @badge CORE }}\n{{// @default-enabled }}\n\n{{#if {{getvar::ProseConventionLaw}}}}BEGIN⠀VEX_PROSE_CONVENTION\nVex:⠀These⠀are⠀the⠀prose⠀conventions⠀I⠀picked.\n{{getvar::ProseConventionLaw}}\nEND⠀VEX_PROSE_CONVENTION{{/if}}\n\n{{trim}}"
