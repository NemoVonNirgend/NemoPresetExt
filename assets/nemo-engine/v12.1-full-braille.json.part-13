        {
            "identifier": "nemo-pad-loader-resolver",
            "name": "🧩 Scratchpad Resolver",
            "system_prompt": false,
            "marker": false,
            "role": "user",
            "content": "{{// @category Core }}\n{{// @tooltip Mandatory hidden Scratchpad resolver. Keep enabled after all Pad Tab selections and Magpie Workbench. Scratchpad off: no pad. Scratchpad alone: legacy HTML. Scratchpad plus any Pad Tab: modular core with selected features. }}\n{{// @color #34495E }}\n{{// @icon 🧩 }}\n{{// @badge CORE }}\n{{// @hidden }}\n{{setvar::NemoScratchpadHasOptions::0}}{{#if {{getvar::NFOManifest}}}}{{setvar::NemoFinalStateSlot::Scratchpad⠀when⠀this⠀resolver⠀selects⠀a⠀pad;⠀otherwise⠀defer⠀to⠀standalone⠀MP⠀or⠀no⠀state⠀host}}{{/if}}{{setvar::NemoScratchpadMode::Off}}{{setvar::NemoScratchpadReminder::}}{{setvar::NemoScratchpadFeatures::}}{{setvar::NemoPadTabs::}}{{setvar::NemoPadDeep::}}{{setvar::NemoPadLoader::}}{{setvar::TurnCarry::}}{{if {{getvar::NemoScratchpadEnabled}}}}{{#if {{getvar::NTOPad}}}}\n{{getvar::NTOPad}}\n{{/if}}{{#if {{getvar::NVPContract}}}}\n{{getvar::NVPContract}}\n{{/if}}{{#if {{getvar::NRBDPadDirective}}}}\n{{getvar::NRBDPadDirective}}\n{{/if}}{{if {{getvar::NemoScratchpadOption_consequence}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadDeep}}{{getvar::NemoPadDeep}}\n[[tab Consequence|deep]]\n»⠀mode⠀|⠀{{getvar::ConsequenceMode}}\n»⠀checkpoint⠀|⠀established⠀checkpoint⠀and⠀why⠀it⠀is⠀valid⠀·⠀fallback⠀current⠀scene⠀opening\n{{getvar::UserRoleConsequenceDirective}}\n{{getvar::NRBDConsequenceRows}}»⠀subject⠀|⠀applicable⠀subject⠀under⠀the⠀resolved⠀user⠀role⠀·⠀none⠀when⠀no⠀consequence⠀subject⠀is⠀assigned\n»⠀terminal⠀count⠀|⠀deaths⠀or⠀terminal⠀events⠀retained⠀by⠀the⠀active⠀consequence⠀subject,⠀if⠀relevant\n»⠀tether⠀/⠀transfer⠀|⠀ghost⠀tether,⠀replacement-character⠀handoff,⠀new-world⠀state,⠀or⠀other⠀persistent⠀consequence\n[[/tab]]{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Consequence{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Consequence}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_parallel}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadTabs}}{{getvar::NemoPadTabs}}\n{{getvar::NOFThreadTab}}{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Parallel⠀Storylines{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Parallel⠀Storylines}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_cutaway}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#if {{getvar::NOFNextTab}}}}{{#setvar::NemoPadTabs}}{{getvar::NemoPadTabs}}\n{{getvar::NOFNextTab}}{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Next⠀Cutaway{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Next⠀Cutaway}}{{/if}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_canon}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadDeep}}{{getvar::NemoPadDeep}}\n[[tab Canon|deep]]\n»⠀fixed⠀|⠀observable⠀established⠀facts⠀that⠀now⠀bind⠀the⠀story\n»⠀open⠀|⠀unresolved⠀meaning,⠀motive,⠀or⠀question⠀not⠀to⠀close⠀cheaply\n»⠀moving⠀|⠀consequence⠀/⠀debt⠀/⠀message⠀/⠀journey⠀·⠀direction⠀·⠀rate\n[[/tab]]{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Canon{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Canon}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_stage}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadDeep}}{{getvar::NemoPadDeep}}\n{{#if {{getvar::NNPEnabled}}}}[[tab Narrative Stage|deep]]\n{{getvar::NNPRows}}\n[[/tab]]{{else}}[[tab Narrative Stage|deep]]\n»⠀plot⠀|⠀current⠀stage⠀·⠀held⠀turns⠀·⠀whether⠀duration⠀fits\n»⠀scene⠀|⠀current⠀stage⠀and⠀transition⠀condition\n»⠀relationships⠀|⠀only⠀relationships⠀with⠀live⠀stage⠀pressure\n»⠀stakes⠀|⠀what⠀can⠀be⠀lost⠀now\n[[/tab]]{{/if}}{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Narrative⠀Stage{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Narrative⠀Stage}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_affinity}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadTabs}}{{getvar::NemoPadTabs}}\n[[tab Affinity|open]]\n{{#if {{getvar::NRMAffinityView}}}}{{getvar::NRMAffinityView}}{{else}}For⠀each⠀tracked⠀relationship,⠀use⠀one⠀character⠀heading⠀followed⠀by⠀exact⠀markers:\n»»⠀[Character⠀Name]\n[[tier Familiar]]\n[[bar affection|34|Warming|+2 · exact event and why this person valued it]]\n[[bar trust|12|Wary|no change · exact reason trust did not move]]\n[[bar desire|0|None|not a register they are operating in now]]\nAffinity,⠀trust,⠀and⠀desire⠀are⠀independent⠀-100⠀to⠀100⠀states.⠀Movement⠀requires⠀a⠀named⠀event⠀and⠀that⠀person's⠀interpretation.⠀Use⠀`[[tier Friend|up from Familiar]]`⠀only⠀on⠀an⠀actual⠀transition.{{/if}}\n[[/tab]]{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Affinity{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Affinity}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_stats}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadTabs}}{{getvar::NemoPadTabs}}\n[[tab Stats|open]]\nFor⠀each⠀tracked⠀character,⠀use⠀one⠀heading⠀and⠀exact⠀stat⠀markers:\n»»⠀[Character⠀Name]\n[[stat STR|10|50|average]][[stat DEX|13|65|strong]][[stat END|8|40|average]][[stat WIL|17|85|exceptional]][[stat INT|11|55|average]][[stat PER|12|60|average]][[stat CHA|9|45|average]][[stat LUC|10|50|average]]\n»⠀condition⠀|⠀current⠀impairment⠀·⠀practical⠀effect\n»⠀skilled⠀at⠀|⠀specific⠀competencies⠀·⠀poor⠀at⠀|⠀specific⠀weaknesses\nThe⠀third⠀field⠀is⠀the⠀0-100⠀bar⠀fill.⠀Keep⠀established⠀values⠀stable;⠀conditions⠀change⠀state,⠀not⠀base⠀identity.\n[[/tab]]{{/setvar}}{{if {{getvar::NemoScratchpadFeatures}}}}{{#setvar::NemoScratchpadFeatures}}{{getvar::NemoScratchpadFeatures}};⠀Stats{{/setvar}}{{else}}{{setvar::NemoScratchpadFeatures::Stats}}{{/if}}{{/if}}{{if {{getvar::NemoScratchpadOption_inventory}}}}{{setvar::NemoScratchpadHasOptions::1}}{{#setvar::NemoPadTabs