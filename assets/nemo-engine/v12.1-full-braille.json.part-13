        {
            "identifier": "cot_step_knowledgemap",
            "name": "🧭 Plan: Knowledge Map",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Map what each character knows, lacks, suspects, or believes incorrectly before action. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_KnowledgeMap::♢⠀>>⠀[PROCEDURE]⠀KNOWLEDGE⠀MAP\nUse⠀existing⠀actor⠀state⠀or⠀establish⠀the⠀relevant⠀knowledge⠀boundary⠀when⠀no⠀map⠀exists.⠀{{#if {{getvar::NemoInterpreterEnabled}}}}Distinguish⠀learned/observed⠀facts,⠀missing⠀information⠀and⠀evidence-supported⠀uncertainty.⠀Use⠀the⠀Interpreter's⠀intended⠀reading⠀for⠀accessible⠀communication;⠀do⠀not⠀add⠀a⠀mistaken⠀reading⠀to⠀fill⠀the⠀map.{{else}}Distinguish⠀learned/observed⠀facts,⠀missing⠀information,⠀tentative⠀inferences,⠀and⠀false⠀beliefs.{{/if}}⠀Check⠀actual⠀evidence⠀and⠀communication⠀routes⠀before⠀a⠀line⠀or⠀act⠀relies⠀on⠀them;⠀narrator⠀knowledge,⠀another⠀private⠀passage,⠀and⠀hidden⠀focal⠀intent⠀are⠀unavailable.⠀Record⠀only⠀the⠀boundary⠀changing⠀this⠀response.}}\n\n{{trim}}\n\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "nemo-world-knowledge-infusion",
            "name": "🧭 Plan: NemoNet Search",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Simulate a NemoNet lookup to invent concrete compatible world detail when the scene needs specificity. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_NemoNetSearch::♢⠀>>⠀[PROCEDURE]⠀##⠀NEMONET⠀SEARCH\n\nPurpose:⠀prevent⠀thin⠀worldbuilding⠀by⠀creating⠀compatible⠀facts⠀when⠀canon⠀is⠀silent.\n\nCheck:\n\n-⠀Query:⠀name⠀the⠀missing⠀detail⠀the⠀scene⠀needs⠀now:⠀place,⠀person,⠀faction,⠀object,⠀custom,⠀law,⠀biology,⠀magic,⠀technology,⠀price,⠀rumor,⠀or⠀history.\n\n-⠀Results:⠀invent⠀1⠀to⠀3⠀concrete⠀details⠀that⠀fit⠀established⠀canon,⠀genre,⠀tone,⠀and⠀current⠀stakes.\n\n-⠀Limits:⠀keep⠀the⠀result⠀provisional⠀until⠀contradicted;⠀never⠀override⠀explicit⠀lore,⠀character⠀cards,⠀chat⠀history,⠀or⠀world⠀info.\n\nApply:⠀weave⠀the⠀useful⠀detail⠀into⠀behavior,⠀environment,⠀dialogue,⠀tracker⠀state,⠀or⠀consequence⠀without⠀announcing⠀the⠀lookup.\n\nDecision:⠀use⠀`NemoNet Result:`⠀followed⠀by⠀only⠀the⠀selected⠀compatible⠀detail⠀and⠀how⠀it⠀enters⠀the⠀scene.⠀Do⠀not⠀expose⠀the⠀lookup⠀as⠀OOC⠀narration⠀unless⠀a⠀tracker⠀explicitly⠀asks⠀for⠀lore⠀notes.}}\n\n{{trim}}\n\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_infoasymmetry",
            "name": "🧭 Plan: Information Asymmetry",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Use knowledge gaps between characters and reader to create tension without telepathy. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_InfoAsymmetry::♢⠀>>⠀[PROCEDURE]⠀##⠀INFORMATION⠀ASYMMETRY\n\nPurpose:⠀turn⠀unequal⠀knowledge⠀into⠀tension,⠀leverage,⠀irony,⠀mystery,⠀or⠀restraint.\n\nCheck:\n\n{{#if {{getvar::NemoInterpreterEnabled}}}}-⠀Audience-over-character:⠀the⠀reader⠀has⠀evidence⠀of⠀danger⠀or⠀events⠀that⠀has⠀not⠀reached⠀a⠀character⠀through⠀an⠀in-world⠀route.{{else}}-⠀Audience-over-character:⠀the⠀reader⠀sees⠀danger,⠀irony,⠀or⠀contradiction⠀a⠀character⠀misses.{{/if}}\n\n{{#if {{getvar::NemoInterpreterEnabled}}}}-⠀Character-over-character:⠀one⠀person⠀holds⠀leverage,⠀a⠀secret,⠀or⠀private⠀context⠀that⠀another⠀has⠀not⠀received.{{else}}-⠀Character-over-character:⠀one⠀person⠀holds⠀leverage,⠀a⠀secret,⠀false⠀confidence,⠀or⠀private⠀context.{{/if}}\n\n-⠀Character-over-audience:⠀mystery⠀stays⠀alive⠀through⠀partial⠀evidence,⠀behavior,⠀and⠀implication.\n\n{{#if {{getvar::NemoInterpreterEnabled}}}}Apply:⠀choose⠀the⠀strongest⠀actual⠀information⠀gap⠀and⠀let⠀it⠀shape⠀what⠀is⠀said,⠀withheld,⠀revealed,⠀clarified,⠀or⠀acted⠀on.⠀Understand⠀the⠀intended⠀meaning⠀of⠀accessible⠀dialogue;⠀do⠀not⠀create⠀tension⠀by⠀assigning⠀an⠀incorrect⠀reading.{{else}}Apply:⠀choose⠀the⠀strongest⠀gap⠀and⠀let⠀it⠀shape⠀what⠀is⠀said,⠀withheld,⠀misunderstood,⠀revealed,⠀or⠀acted⠀on.{{/if}}\n\nDecision:⠀record⠀only⠀the⠀knowledge⠀gap⠀that⠀changes⠀this⠀beat.⠀Never⠀explain⠀the⠀asymmetry⠀directly⠀in⠀narration⠀unless⠀the⠀scene⠀reveals⠀it.}}\n\n{{trim}}\n\n",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_lastcritique",
            "name": "🧭 Plan: Last Turn Critique",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Audit the previous response and carry one concrete repair forward. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_LastCritique::♢⠀>>⠀[PROCEDURE]⠀##⠀LAST⠀TURN⠀CRITIQUE\n\nPurpose:⠀repair⠀drift⠀from⠀the⠀previous⠀assistant⠀response⠀before⠀writing⠀the⠀next⠀one.\n\nCheck:\n\n-⠀Role⠀authority:⠀{{getvar::UserRoleDraftAuditDirective}}\n\n-⠀Knowledge:⠀each⠀character⠀used⠀only⠀their⠀own⠀information.\n\n-⠀Craft:⠀phrasing,⠀rhythm,⠀gestures,⠀and⠀sentence⠀shapes⠀stayed⠀specific⠀rather⠀than⠀recycled.\n\n-⠀Momentum:⠀the⠀scene⠀advanced⠀through⠀reaction,⠀consequence,⠀pressure,⠀or⠀decision.\n\nApply:⠀pick⠀one⠀concrete⠀repair⠀and⠀carry⠀it⠀into⠀this⠀response.\n\nDecision:⠀record⠀one⠀concrete⠀repair⠀only⠀when⠀the⠀previous⠀turn⠀created⠀drift.⠀Do⠀not⠀apologize,⠀self-report,⠀or⠀mention⠀the⠀audit⠀in⠀narration.}}\n\n{{trim}}\n\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_charstate",
            "name": "🧭 Plan: Character State",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Snapshot each present character?s physical, spatial, emotional, and motivational state. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_CharState::♢⠀>>⠀[PROCEDURE]⠀CHARACTER⠀STATE\n{{getvar::UserRoleCharacterStateDirective}}\nEstablish⠀one⠀working⠀snapshot⠀for⠀relevant⠀present⠀characters⠀from⠀current⠀accepted⠀state:⠀body,⠀breath,⠀and⠀usable⠀strength;⠀injury,⠀fatigue,⠀pain,⠀arousal,⠀mood,⠀clothing,⠀equipment⠀or⠀restraints;⠀exact⠀position,⠀contact,⠀line⠀of⠀sight,⠀exits,⠀cover⠀and⠀reach;⠀{{#if {{getvar::NemoInterpreterEnabled}}}}own⠀knowledge,⠀actual⠀information⠀gaps⠀and⠀the⠀Interpreter's⠀resolved⠀communication;{{else}}own⠀knowledge⠀and⠀false⠀beliefs;{{/if}}⠀immediate⠀wants⠀and⠀newly⠀changed⠀pressure.⠀Reuse⠀this⠀snapshot⠀in⠀later⠀checks.⠀Record⠀only⠀fields⠀affecting⠀the⠀next⠀beat;⠀no⠀prose⠀status⠀dump⠀unless⠀a⠀selected⠀tracker⠀requires⠀it.}}\n\n{{trim}}\n\n",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_mental_projection",
            "name": "🧠 Plan: Mental Projection Compatibility",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Planning-Steps }}{{// @tooltip Optional Mental Projection adapter for the eight existing Planning Modes. Master-gated; supplies one state handoff and an endpoint audit inside the selected host. Dedicated Mental Projection Plan already includes its own workflow and does not emit this adapter. }}{{// @color #7C3AED }}{{// @icon 🧠 }}{{// @badge MODULE }}\n{{setvar::PlanStep_MentalProjection::}}{{setvar::PlanAudit_MentalProjection::}}{{#if {{getvar::NMPEnabled}}}}{{#if {{getvar::NMPPlan}}}}{{#setvar::PlanStep_MentalProjection}}MENTAL⠀PROJECTION:⠀COMPATIBILITY⠀BRIDGE\nKeep⠀this⠀host's⠀identity,⠀wrapper,⠀required⠀phases⠀and⠀enabled⠀editorial⠀modules.⠀The⠀state-transition⠀instructions⠀below⠀are⠀dependencies⠀within⠀those⠀phases,⠀not⠀a⠀second⠀prelude⠀that⠀runs⠀the⠀whole⠀scene⠀before⠀the⠀host⠀starts.⠀Resolve⠀input⠀classification/OOC⠀first;⠀inherit⠀and⠀appraise⠀before⠀deciding⠀conduct;⠀weave⠀subsequent⠀experience⠀into⠀the⠀same⠀shared⠀event⠀order;⠀finalize⠀state⠀only⠀from⠀the⠀accepted⠀candidate.\n\nCharacter⠀State⠀supplies⠀one⠀shared⠀working⠀snapshot.⠀Character⠀Turn⠀Simulation⠀orders⠀the⠀same⠀acts.⠀Knowledge,⠀relationship,⠀emotion,⠀voice⠀and⠀other⠀checks⠀refine⠀that⠀state⠀without⠀restarting⠀it⠀or⠀overriding⠀an⠀active⠀VALUE⠀definition.⠀Apply⠀each⠀actual⠀cause⠀once⠀per⠀receiving⠀field,⠀with⠀the⠀source's⠀bounded⠀reassessment;⠀later⠀genuinely⠀new⠀events⠀may⠀update⠀it⠀again.⠀Only⠀enabled⠀MP⠀groups⠀participate.⠀Required⠀character⠀interiority⠀remains⠀fiction,⠀and⠀Vex⠀remains⠀the⠀authorial⠀lens⠀rather⠀than⠀an⠀in-world⠀mental-state⠀owner.\n\n{{getvar::NMPPlan}}{{/setvar}}{{#setvar::PlanAudit_MentalProjection}}MENTAL⠀PROJECTION:⠀CONSISTENCY⠀AND⠀ENDPOINT⠀CHECK\nUse⠀the⠀host's⠀existing⠀candidate⠀review,⠀compliance⠀step⠀or⠀Workbench⠀SHAPE⠀stage;⠀this⠀is⠀its⠀mental-state⠀checklist,⠀not⠀another⠀simulation⠀or⠀review⠀loop.⠀Before⠀publication,⠀check⠀each⠀material⠀thought,⠀line⠀and⠀act⠀against⠀that⠀person's⠀inherited⠀state,⠀available⠀knowledge⠀and⠀actual⠀chronology.⠀Repair⠀unsupported⠀numerical⠀drift,⠀lost⠀owner/scope,⠀invented⠀knowledge,⠀disabled-field⠀effects,⠀backdated⠀motives⠀and⠀duplicate⠀causal⠀charges.⠀Preserve⠀genuine⠀uncertainty,⠀unchanged⠀values⠀and⠀incomplete⠀actions.⠀Character⠀speech⠀alone⠀does⠀not⠀overwrite⠀established⠀private⠀state.⠀Check⠀material⠀bodily⠀effects⠀and⠀relationship⠀changes⠀against⠀their⠀actual⠀causes⠀and⠀available⠀history:⠀no⠀invented⠀source⠀episode,⠀forced⠀symptom,⠀label-to-chemistry⠀inference,⠀copied⠀partner⠀state⠀or⠀second⠀reward⠀for⠀the⠀same⠀cue.⠀Retain⠀supported⠀implicit⠀associations⠀without⠀calling⠀them⠀conscious⠀recall.\n\nRepair⠀the⠀candidate⠀and⠀reconcile⠀its⠀endpoint⠀from⠀the⠀SAME⠀predecessor⠀and⠀accepted⠀events.⠀Do⠀not⠀simulate⠀discarded⠀versions⠀as⠀lived⠀events⠀or⠀charge⠀a⠀correction⠀as⠀another⠀cause.⠀Check⠀one⠀complete⠀source-schema⠀snapshot⠀per⠀eligible⠀character⠀with⠀its⠀stable⠀character_key/current⠀timeline,⠀matching⠀identity⠀pairs⠀in⠀the⠀adjacent⠀retention⠀capsule,⠀retained⠀record⠀IDs,⠀correct⠀privacy⠀and⠀the⠀existing⠀tracker⠀host.⠀Apply⠀the⠀shared⠀legacy/branch⠀identity⠀contract⠀rather⠀than⠀merging⠀display-name⠀matches.⠀A⠀Scratchpad⠀summary⠀references⠀the⠀same⠀endpoint;⠀it⠀does⠀not⠀own⠀duplicate⠀numerical⠀state.⠀Only⠀published⠀fiction⠀and⠀state⠀enter⠀continuity.⠀Map⠀annotations⠀are⠀read-only.⠀Never⠀put⠀model⠀deliberation⠀into⠀character⠀fields⠀or⠀replace⠀required⠀live⠀interiority⠀with⠀this⠀check.{{/setvar}}{{else}}{{setvar::NMPPlanningIssue::[OOC:⠀MENTAL⠀PROJECTION⠀PLANNING⠀DEPENDENCY.⠀Mental⠀Projection⠀is⠀enabled⠀but⠀its⠀automatic⠀State⠀contract⠀&⠀planning⠀bridge⠀supplied⠀no⠀transition.⠀Restore⠀that⠀automatic⠀prompt⠀before⠀using⠀the⠀compatibility⠀module;⠀do⠀not⠀invent⠀missing⠀state⠀rules.]}}{{/if}}{{/if}}\n{{trim}}",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_character_turn_simulation",
            "name": "⏱️ Plan: In-Scene Character Turn Simulation",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Planning-Steps }}\n{{// @tooltip Simulate every relevant in-scene actor from live state, with the selected user-role contract deciding whether the current input is a move, canonical prose, authored character input, or direction. }}\n{{// @color #E67E22 }}\n{{// @icon ⏱️ }}\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_CharacterTurnSimulation::♢⠀>>⠀[PROCEDURE]⠀IN-SCENE⠀CHARACTER⠀TURN⠀SIMULATION\n{{getvar::UserRoleSimulationDirective}}\n{{#if {{getvar::PlanStep_CharState}}}}Reuse⠀the⠀working⠀Character⠀State⠀snapshot;⠀extend⠀it⠀only⠀with⠀missing⠀relevant⠀bodies,⠀exact⠀positions,⠀reach,⠀line⠀of⠀sight,⠀resources,⠀{{else}}Establish⠀the⠀relevant⠀bodies,⠀exact⠀positions,⠀reach,⠀line⠀of⠀sight,⠀resources,⠀{{/if}}{{#if {{getvar::NemoInterpreterEnabled}}}}knowledge,⠀actual⠀information⠀gaps,⠀understood⠀communication,⠀motives,⠀and⠀pressures{{else}}knowledge/false⠀beliefs,⠀motives,⠀and⠀pressures{{/if}}⠀once.⠀Add⠀current⠀action/inertia,⠀readiness,⠀likely⠀interruption,⠀and⠀the⠀concrete⠀beat⠀each⠀relevant⠀actor⠀takes⠀now.\n\nOrder⠀intersecting⠀beats⠀by⠀causality,⠀readiness,⠀speed,⠀position,⠀knowledge,⠀skill,⠀and⠀interference,⠀never⠀user-first⠀courtesy,⠀prompt⠀order,⠀or⠀a⠀round-robin⠀quota.⠀Background⠀tasks⠀continue⠀when⠀causally⠀relevant.⠀Resolve⠀ordinary⠀uncontested⠀motion⠀directly;⠀uncertain⠀beats⠀use⠀established⠀capability,⠀preparation,⠀opposition,⠀world⠀rules,⠀and⠀selected⠀Difficulty/dice/tactical⠀systems.⠀Keep⠀minds⠀separate.\n\nProduce⠀one⠀shared⠀causal⠀event⠀order⠀for⠀the⠀role-classified⠀input⠀and⠀cast.⠀Route⠀terminal⠀aftermath⠀only⠀to⠀its⠀authorized⠀Consequence⠀subject⠀and⠀end⠀at⠀the⠀selected⠀role's⠀continuation⠀boundary.}}\n{{trim}}",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_coursecorrect",
            "name": "🧭 Plan: Course Correction",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Check whether the scene is advancing, drifting productively, or losing pressure. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_CourseCorrect::♢⠀>>⠀[PROCEDURE]⠀##⠀COURSE⠀CORRECTION\n\nPurpose:⠀keep⠀the⠀story⠀moving⠀without⠀forcing⠀artificial⠀plot⠀turns.\n\nCheck:\n\n-⠀Trajectory:⠀confrontation,⠀intimacy,⠀discovery,⠀danger,⠀escape,⠀bargain,⠀collapse,⠀relief,⠀transition,⠀or⠀quiet⠀character⠀reveal.\n\n-⠀Thread⠀status:⠀active,⠀neglected,⠀ready⠀for⠀payoff,⠀ready⠀for⠀complication,⠀or⠀complete.\n\n-⠀Drift:⠀fruitful⠀tangent⠀that⠀reveals⠀character/world,⠀or⠀dead⠀air⠀that⠀needs⠀pressure.\n\nApply:⠀keep⠀fruitful⠀motion;⠀cut⠀filler;⠀add⠀pressure⠀only⠀when⠀the⠀scene⠀has⠀gone⠀slack.\n\nDecision:⠀record⠀the⠀selected⠀trajectory⠀only⠀when⠀the⠀scene⠀needs⠀correction.⠀Do⠀not⠀announce⠀course⠀correction⠀in⠀narration.}}\n\n{{trim}}\n\n",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "cot_step_pacingbeats",
            "name": "🧭 Plan: Pacing Beats",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Set how much story this response should cover and where it should land. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_PacingBeats::♢⠀>>⠀[PROCEDURE]⠀##⠀PACING⠀BEATS\n\nPurpose:⠀choose⠀the⠀response⠀span⠀before⠀drafting.\n\nCheck:\n\n-⠀Beat⠀count:⠀one⠀exchange,⠀one⠀action⠀chain,⠀one⠀transition,⠀one⠀reveal,⠀or⠀one⠀compact⠀scene⠀segment.\n\n-⠀Landing:⠀decision⠀point,⠀in-character⠀question,⠀impact,⠀discovery,⠀interruption,⠀changed⠀leverage,⠀or⠀consequence⠀arriving.\n\n-⠀Shared⠀interval:⠀classify⠀the⠀current⠀input⠀through⠀the⠀active⠀User⠀Role⠀Contract,⠀include⠀every⠀intersecting⠀relevant⠀actor⠀beat⠀from⠀Character⠀Turn⠀Simulation,⠀and⠀land⠀at⠀the⠀continuation⠀point⠀that⠀contract⠀defines.\n\nApply:⠀preserve⠀the⠀causal⠀event⠀order⠀from⠀Character⠀Turn⠀Simulation⠀and⠀stop⠀at⠀a⠀live⠀opening,⠀not⠀a⠀flat⠀pause⠀or⠀permission⠀request.\n\nDecision:⠀record⠀the⠀intended⠀response⠀span⠀and⠀landing⠀beat.⠀Do⠀not⠀describe⠀pacing⠀choices⠀in⠀narration.}}\n\n{{trim}}\n\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
