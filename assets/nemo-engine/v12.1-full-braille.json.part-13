        {
            "identifier": "cot_step_physicalground",
            "name": "🧭 Plan: Physical Grounding",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Anchor the scene in usable space, body mechanics, and sensory reality. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_PhysicalGround::♢⠀>>⠀[PROCEDURE]⠀PHYSICAL⠀GROUNDING\nVerify⠀the⠀working⠀scene⠀state,⠀or⠀establish⠀relevant⠀geometry⠀if⠀absent:⠀layout,⠀distance,⠀obstacles,⠀cover,⠀sightlines,⠀exits;⠀light/sound/temperature⠀and⠀other⠀useful⠀sensory⠀facts;⠀weight,⠀balance,⠀reach,⠀grip,⠀breath,⠀clothing,⠀wounds,⠀fatigue,⠀and⠀contact.⠀Preserve⠀positions⠀and⠀objects.⠀Select⠀the⠀physical⠀fact⠀that⠀changes⠀action,⠀risk,⠀intention,⠀or⠀meaning⠀rather⠀than⠀a⠀room⠀inventory.}}\n\n{{trim}}\n\n",
