        {
            "identifier": "cot_step_relationshipstage",
            "name": "🧭 Plan: Relationship Stage",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n\n{{// @category Planning-Steps }}\n\n{{// @tooltip Respect what the relationship has actually earned, damaged, or made possible. }}\n\n{{// @color #E67E22 }}\n\n{{// @icon 🧭 }}\n\n{{// @badge PLAN }}\n\n{{setvar::PlanStep_RelationshipStage::♢⠀>>⠀[PROCEDURE]⠀##⠀RELATIONSHIP⠀STAGE\n\nPurpose:⠀keep⠀intimacy,⠀trust,⠀conflict,⠀and⠀refusal⠀proportional⠀to⠀history.\n\nCheck:\n\n-⠀Trust:⠀earned,⠀damaged,⠀assumed,⠀transactional,⠀coerced,⠀intimate,⠀fragile,⠀or⠀absent.\n\n-⠀History:⠀debts,⠀injuries,⠀secrets,⠀attraction,⠀rivalry,⠀obligation,⠀shared⠀jokes,⠀betrayals,⠀promises.\n\n-⠀Permission:⠀what⠀touch,⠀honesty,⠀teasing,⠀command,⠀refusal,⠀help,⠀cruelty,⠀or⠀vulnerability⠀this⠀stage⠀supports.\n\n-⠀Direction:⠀warming,⠀cooling,⠀destabilizing,⠀repairing,⠀escalating,⠀or⠀ending.\n\nApply:⠀no⠀instant⠀closeness,⠀instant⠀forgiveness,⠀or⠀convenient⠀compliance⠀unless⠀the⠀relationship⠀has⠀earned⠀it.\n\nDecision:⠀record⠀only⠀the⠀relationship⠀permission,⠀limit,⠀or⠀direction⠀that⠀changes⠀this⠀beat.⠀Do⠀not⠀label⠀the⠀stage⠀in⠀visible⠀narration.}}\n\n{{trim}}\n\n",
            "enabled": true,
            "injection_position": 0,
