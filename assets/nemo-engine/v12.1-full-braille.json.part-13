            "content": "{{// @category Planning-Delivery }}{{// @tooltip Read the current model once per request. Exact allowlist only; keep after delivery controls and before planning steps/hosts. }}{{// @icon 🧭 }}{{// @badge AUTO }}{{// @hidden }}\n{{setvar::NMDModel::{{model}}}}{{setvar::NMDPolicy::{{getvarkey::NMDRegistry::{{getvar::NMDModel}}}}}}{{setvar::NMDRoute::regular}}{{setvar::NMDReason::unknown_or_no_confirmed_prefill_failure}}{{setvar::NMDActive::}}{{setvar::NMDTailIssue::}}{{setvar::NMDContract::}}{{setvar::NMDVariant::}}{{#if {{.NMDMode == workbench}}}}{{setvar::NMDRoute::workbench}}{{setvar::NMDReason::manual_visible}}{{else}}{{#if {{.NMDMode == regular}}}}{{setvar::NMDReason::manual_regular}}{{else}}{{#if {{.NMDPolicy == CB}}}}{{setvar::NMDRoute::selfopen}}{{setvar::NMDReason::listed_prefill_blocker_CB_self_open}}{{/if}}{{#if {{.NMDPolicy == GB}}}}{{setvar::NMDRoute::selfopen}}{{setvar::NMDReason::listed_prefill_blocker_GB_self_open}}{{/if}}{{#if {{getvar::NMDIncludeSummaries}}}}{{#if {{.NMDPolicy == GS}}}}{{setvar::NMDRoute::workbench}}{{setvar::NMDReason::opted_in_summary_adapter_GS}}{{/if}}{{#if {{.NMDPolicy == OS}}}}{{setvar::NMDRoute::workbench}}{{setvar::NMDReason::opted_in_summary_adapter_OS}}{{/if}}{{#if {{.NMDPolicy == XS}}}}{{setvar::NMDRoute::workbench}}{{setvar::NMDReason::opted_in_summary_adapter_XS}}{{/if}}{{/if}}{{/if}}{{/if}}{{trim}}",
