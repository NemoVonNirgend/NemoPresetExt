        {
            "identifier": "1770095491833-adrmydb8",
            "name": "🧭 Main Plan",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Planning }}\n{{// @tooltip Main Plan — thorough scene planning without narrated self-commentary. }}\n{{// @color #3498DB }}\n{{// @icon 🧭 }}\n{{// @badge PLAN }}\n{{// @mutual-exclusive-group Planning-Mode }}\n{{// @exclusive-with-message Only one planning style can be active at a time. }}\n{{// Selected planning host registration. One canonical CoT body is shared by every delivery transport. }}\n{{#if {{getvar::NemoPlanHostId}}}}{{#if {{.NemoPlanHostId != main}}}}{{setvar::NemoPlanConflict::1}}{{/if}}{{/if}}\n{{setvar::NemoPlanHostId::main}}\n{{setvar::NemoPlanHostName::Main Plan}}\n{{setvar::NemoPlanOpen::<plan>}}\n{{setvar::NemoPlanClose::</plan>}}\n{{setvar::NemoPlanGenerationType::{{lastGenerationType}}}}\n{{setvar::PlanningAssistantPrefill::}}\n{{setvar::PlanningLanguageSplit::♢⠀>>⠀[PROCEDURE]⠀Language⠀split:⠀planning/scaffold⠀work⠀uses⠀{{getvar::PlanningLanguage}};⠀the⠀accepted⠀final⠀response⠀uses⠀{{getvar::Language}}.⠀The⠀delivery⠀transport⠀alone⠀decides⠀whether⠀the⠀planning⠀work⠀is⠀wrapped⠀in⠀a⠀native⠀planning⠀tag⠀or⠀a⠀Nemo⠀workbench.⠀Do⠀not⠀let⠀English⠀prompt⠀scaffolding⠀override⠀the⠀selected⠀languages.}}\n{{#setvar::NemoPlanBody}}\n♢⠀>>⠀[PROCEDURE]⠀{{getvar::VexPlanName}}⠀Main⠀Plan\nUse⠀this⠀for⠀full⠀scene⠀planning.⠀Laws⠀and⠀boundaries⠀remain⠀fixed;⠀planning⠀selects⠀how⠀the⠀response⠀executes⠀them.\n\n{{#if {{getvar::NemoInterpreterEnabled}}}}{{getvar::UserRolePlanDirective}}\n{{getvar::NemoInterpreterPlan}}\n{{getvar::InteriorityPlanDirective}}{{else}}{{getvar::UserRolePlanDirective}}\n{{getvar::InteriorityPlanDirective}}{{/if}}{{#if {{getvar::NNPEnabled}}}}\n{{getvar::NNPRead}}{{/if}}\n{{getvar::PlanStep_MentalProjection}}\n{{getvar::PlanTail_ExactDraftSetup}}\n\n1.⠀Command⠀and⠀boundaries\n-⠀Resolve⠀explicit⠀OOC⠀instructions,⠀corrections,⠀retcons,⠀skips,⠀mode⠀changes,⠀format,⠀rating,⠀language,⠀and⠀active⠀constraints⠀first.\n-⠀Classify⠀the⠀current⠀input⠀exactly⠀as⠀the⠀resolved⠀User⠀Role⠀Contract⠀requires.⠀Do⠀not⠀convert⠀it⠀into⠀another⠀role's⠀input⠀type.\n-⠀Agency,⠀canon,⠀knowledge,⠀physical,⠀and⠀format⠀limits⠀that⠀materially⠀affect⠀this⠀turn.\n\n2.⠀Live⠀scene⠀state\n-⠀Who⠀is⠀present.\n-⠀What⠀each⠀relevant⠀person⠀knows⠀and⠀wants.\n-⠀Position,⠀injury,⠀object,⠀clock,⠀relationship,⠀ongoing⠀action,⠀or⠀unresolved⠀thread⠀that⠀changes⠀the⠀next⠀beat.\n\n{{#if {{.NSSCount > 1}}}}{{getvar::NSSPreparation}}{{else}}{{getvar::PlanStep_CharState}}{{/if}}\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_CharacterTurnSimulation}}{{/if}}\n\n3.⠀Active⠀Vex⠀lens\n-⠀Vex:⠀{{getvar::VexPlanName}}\n-⠀Core:⠀{{getvar::VexPlanCore}}\n-⠀Bias:⠀{{getvar::VexPlanBias}}\n-⠀Anchor:⠀{{getvar::VexPlanAnchor}}\n-⠀Load-bearing⠀question:⠀{{getvar::VexPlanQuestion}}\n-⠀Physical⠀key:⠀{{getvar::VexPlanPhysicalKey}}\n-⠀Character⠀key:⠀{{getvar::VexPlanCharacterKey}}\n-⠀Development⠀key:⠀{{getvar::VexPlanDevelopmentKey}}\n-⠀Speech⠀key:⠀{{getvar::VexPlanSpeechKey}}\n-⠀Avoid:⠀{{getvar::VexPlanAvoids}}\n\n4.⠀Selected⠀direction\n-⠀Which⠀in-world⠀actor⠀acts⠀first⠀and⠀why.\n-⠀The⠀immediate⠀changed⠀condition.\n-⠀One⠀concrete⠀scene-specific⠀detail.\n-⠀One⠀source⠀of⠀friction,⠀desire,⠀danger,⠀cost,⠀vulnerability,⠀leverage,⠀or⠀relief.\n-⠀One⠀landing⠀beat⠀that⠀creates⠀a⠀live⠀situation⠀rather⠀than⠀a⠀permission⠀question.\n\n5.⠀Optional⠀specificity\n-⠀Invent⠀only⠀missing⠀compatible⠀detail⠀needed⠀now.\n-⠀Do⠀not⠀announce⠀lookup⠀or⠀planning⠀machinery.\n-⠀Never⠀contradict⠀established⠀cards,⠀chat⠀history,⠀world⠀information,⠀or⠀direct⠀user⠀statements.\n\nActive⠀modular⠀decision⠀checks:\n{{#if {{getvar::NIFBlock}}}}{{getvar::NIFBlock}}{{else}}{{getvar::PlanStep_KnowledgeMap}}{{/if}}\n{{getvar::PlanStep_NemoNetSearch}}\n{{#if {{getvar::NIFBlock}}}}{{else}}{{getvar::PlanStep_InfoAsymmetry}}{{/if}}\n{{getvar::PlanStep_LastCritique}}\n{{#if {{getvar::NTDBlock}}}}{{getvar::NTDBlock}}{{else}}{{getvar::PlanStep_CourseCorrect}}{{/if}}\n{{#if {{getvar::NTDBlock}}}}{{else}}{{getvar::PlanStep_PacingBeats}}{{/if}}\n{{#if {{getvar::NTDBlock}}}}{{else}}{{getvar::PlanStep_NarrativeHook}}{{/if}}\n{{getvar::PlanStep_NSFWFocus}}\n{{getvar::PlanStep_VoiceCraft}}\n{{#if {{getvar::NIFBlock}}}}{{else}}{{getvar::PlanStep_Subtext}}{{/if}}\n{{getvar::PlanStep_RelationshipStage}}\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_PhysicalGround}}{{/if}}\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_EmotionalMatrix}}{{/if}}\n\n{{getvar::PlanTail_DraftAttack}}\n{{getvar::PlanTail_DraftCompliance}}{{#if {{getvar::NNPEnabled}}}}\n{{getvar::NNPAudit}}{{/if}}\n{{getvar::PlanAudit_MentalProjection}}\n\n{{#if {{getvar::NRPReady}}}}{{getvar::NRPBlock}}{{else}}{{getvar::PlanStep_HTMLDesign}}{{/if}}\n{{#if {{getvar::NRPReady}}}}{{else}}{{getvar::PlanStep_HTMLMarkers}}{{/if}}\n{{getvar::PlanTail_FinalDraft}}\n{{getvar::PlanTail_MagpieWorkbench}}\n{{/setvar}}\n{{trim}}",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "nemo-plan-mental-projection",
            "name": "🧠 Mental Projection Plan",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Planning }}\n{{// @tooltip Mental Projection Plan - state-first scene planning using the enabled MP groups and existing tracker. Requires the Mental Projection master and its automatic state contract. Select instead of another Planning Mode; the Compatibility module is not required. }}\n{{// @color #7C3AED }}\n{{// @icon 🧠 }}\n{{// @badge PLAN }}\n{{// @mutual-exclusive-group Planning-Mode }}\n{{// @exclusive-with-message Select exactly one Planning Mode. Mental Projection Plan already includes its own integration; do not also select another host. }}\n{{// Selected planning host registration. One canonical CoT body is shared by every delivery transport. }}\n{{#if {{getvar::NemoPlanHostId}}}}{{#if {{.NemoPlanHostId != mental_projection}}}}{{setvar::NemoPlanConflict::1}}{{/if}}{{/if}}\n{{setvar::NemoPlanHostId::mental_projection}}\n{{setvar::NemoPlanHostName::Mental Projection Plan}}\n{{setvar::NemoPlanOpen::<plan>}}\n{{setvar::NemoPlanClose::</plan>}}\n{{setvar::NemoPlanGenerationType::{{lastGenerationType}}}}\n{{setvar::PlanningAssistantPrefill::}}\n{{setvar::PlanningLanguageSplit::♢⠀>>⠀[PROCEDURE]⠀Language⠀split:⠀planning/scaffold⠀work⠀uses⠀{{getvar::PlanningLanguage}};⠀the⠀accepted⠀final⠀response⠀uses⠀{{getvar::Language}}.⠀The⠀delivery⠀transport⠀alone⠀decides⠀whether⠀the⠀planning⠀work⠀is⠀wrapped⠀in⠀a⠀native⠀planning⠀tag⠀or⠀a⠀Nemo⠀workbench.⠀Do⠀not⠀let⠀English⠀prompt⠀scaffolding⠀override⠀the⠀selected⠀languages.}}\n{{#setvar::NemoPlanBody}}\n♢⠀>>⠀[PROCEDURE]⠀MENTAL⠀PROJECTION⠀PLAN\nUse⠀the⠀active⠀Mental⠀Projection⠀definitions⠀to⠀establish⠀how⠀each⠀eligible⠀character⠀experiences⠀the⠀interval⠀before⠀deciding⠀that⠀character's⠀conduct.⠀Character⠀state⠀supplies⠀causes;⠀the⠀Vex⠀lens⠀shapes⠀the⠀telling.⠀This⠀is⠀one⠀planning⠀host,⠀not⠀a⠀second⠀narrator,⠀another⠀council,⠀or⠀a⠀second⠀simulation.\n\nSTEP⠀NOTES:⠀Follow⠀these⠀phases⠀in⠀causal⠀order.⠀Keep⠀notes⠀to⠀material⠀state,⠀decisions,⠀constraints⠀and⠀corrections;⠀no⠀exhaustive⠀value-by-value⠀derivation,⠀invented⠀internal⠀debate,⠀or⠀performance⠀report.⠀Fictional⠀character⠀inner⠀speech⠀is⠀story⠀content,⠀not⠀the⠀model's⠀private⠀reasoning.⠀Empty⠀checks⠀need⠀no⠀filler.⠀The⠀supplied⠀drafting⠀policy⠀governs⠀any⠀response⠀draft⠀and⠀review.\n\n{{getvar::UserRolePlanDirective}}\n{{getvar::InteriorityPlanDirective}}{{#if {{getvar::NNPEnabled}}}}\n{{getvar::NNPRead}}{{/if}}\n{{getvar::PlanTail_ExactDraftSetup}}\n\n1.⠀SCOPE⠀AND⠀INHERIT\nClassify⠀the⠀current⠀message⠀under⠀the⠀active⠀User⠀Role⠀Contract⠀before⠀advancing⠀time.⠀Separate⠀OOC⠀changes,⠀canonical⠀coauthor⠀prose,⠀live⠀attempts,⠀and⠀directions.⠀Identify⠀only⠀eligible⠀in-world⠀minds;⠀the⠀human⠀and⠀Vex⠀council⠀receive⠀no⠀psychological⠀snapshot⠀merely⠀by⠀being⠀present⠀in⠀instructions.\n\nFor⠀each⠀principal⠀eligible⠀character,⠀locate⠀the⠀latest⠀complete⠀applicable⠀mental_state⠀by⠀character_key⠀and⠀timeline⠀under⠀the⠀shared⠀identity⠀contract.⠀Resolve⠀legacy⠀identity⠀or⠀an⠀authorized⠀predecessor/checkpoint⠀source⠀first⠀where⠀needed;⠀a⠀name⠀alone⠀does⠀not⠀establish⠀ownership.⠀Preserve⠀character⠀identity,⠀stable⠀record⠀IDs,⠀sources,⠀unresolved⠀goals⠀and⠀meaningful⠀dormant⠀records.⠀Repair⠀individual⠀gaps⠀from⠀valid⠀earlier⠀state,⠀then⠀current⠀evidence,⠀then⠀the⠀owning⠀definition's⠀fallback;⠀never⠀reset⠀the⠀whole⠀mind⠀or⠀treat⠀an⠀illustration⠀as⠀history.⠀A⠀disabled⠀field⠀remains⠀inert⠀carryover,⠀not⠀zero.⠀This⠀plan⠀adds⠀no⠀VALUE⠀definitions⠀and⠀activates⠀no⠀disabled⠀group.\n\nUse⠀one⠀working⠀state⠀and⠀one⠀causal⠀event⠀ledger⠀throughout⠀this⠀reply.⠀The⠀generic⠀Character⠀State⠀check⠀may⠀add⠀positions⠀and⠀other⠀relevant⠀world⠀facts;⠀it⠀reuses⠀the⠀inherited⠀mental⠀values⠀rather⠀than⠀creating⠀a⠀competing⠀mental⠀snapshot.\n{{#if {{.NSSCount > 1}}}}{{getvar::NSSPreparation}}{{else}}{{getvar::PlanStep_CharState}}{{/if}}\n{{#if {{getvar::NIFBlock}}}}{{getvar::NIFBlock}}{{else}}{{getvar::PlanStep_KnowledgeMap}}{{/if}}\n{{getvar::PlanStep_NemoNetSearch}}\n{{getvar::PlanStep_LastCritique}}\n\n2.⠀RECEIVE⠀AND⠀APPRAISE\nSeparate⠀what⠀happened,⠀what⠀this⠀person⠀could⠀receive,⠀what⠀their⠀inherited⠀attention⠀notices,⠀and⠀what⠀they⠀believe⠀it⠀means.⠀Count⠀elapsed⠀fictional⠀time⠀and⠀each⠀new⠀cause⠀once.⠀Ongoing⠀pressure⠀may⠀persist⠀unchanged.⠀A⠀retelling,⠀note,⠀edit⠀or⠀repeated⠀tracker⠀is⠀not⠀another⠀event.⠀Character⠀knowledge⠀never⠀inherits⠀narrator-only⠀facts⠀or⠀another⠀person's⠀private⠀passage.\n{{#if {{getvar::NMPg_body}}}}\nBODY⠀/⠀CHEMISTRY:⠀Apply⠀the⠀active⠀bodily⠀and⠀neurochemical-inspired⠀definitions⠀with⠀their⠀own⠀ranges,⠀anchors,⠀recovery⠀conditions⠀and⠀interactions.⠀Preserve⠀nonhuman⠀adaptations⠀and⠀nulls.⠀No⠀emotion⠀equals⠀one⠀chemical,⠀and⠀no⠀score⠀commands⠀behaviour.⠀Use⠀actual⠀condition,⠀sensation⠀and⠀possible⠀misinterpretation⠀before⠀conduct.⠀Select⠀supported⠀manifestations⠀without⠀charging⠀a⠀symptom⠀as⠀another⠀independent⠀cause.\n{{/if}}{{#if {{getvar::NMPg_appraisal}}}}\nNEEDS⠀/⠀APPRAISAL:⠀Update⠀receiving⠀needs⠀from⠀their⠀own⠀causes.⠀Keep⠀appraisals⠀tied⠀to⠀a⠀specific⠀issue,⠀target⠀and⠀stake.⠀Threat⠀and⠀reward⠀can⠀coexist;⠀an⠀improvement⠀in⠀one⠀concern⠀does⠀not⠀settle⠀every⠀concern.⠀Allow⠀one⠀bounded⠀reassessment⠀where⠀changed⠀condition⠀genuinely⠀changes⠀interpretation.\n{{/if}}\n{{#if {{getvar::NIFBlock}}}}{{else}}{{getvar::PlanStep_InfoAsymmetry}}{{/if}}\n\n3.⠀REMEMBER,⠀WANT⠀AND⠀CHOOSE\nUse⠀the⠀person's⠀established⠀values,⠀habits,⠀knowledge⠀and⠀competing⠀obligations,⠀not⠀an⠀idealized⠀optimizer.⠀Preserve⠀uncertainty⠀and⠀mixed⠀motives⠀without⠀manufacturing⠀conflict⠀or⠀introspection.⠀Decide⠀only⠀among⠀options⠀this⠀person⠀could⠀notice⠀or⠀consider.\n{{#if {{getvar::NMPg_memory}}}}\nMEMORY⠀/⠀LEARNING:⠀Retrieve⠀by⠀supported⠀cues,⠀accessibility,⠀trace,⠀fidelity⠀and⠀interference.⠀Gist,⠀uncertain⠀detail⠀and⠀failure⠀to⠀recall⠀remain⠀distinct.⠀Reading⠀a⠀tracker⠀is⠀not⠀rehearsal.⠀Learn⠀only⠀from⠀actual⠀experienced⠀evidence,⠀with⠀its⠀scope⠀and⠀source⠀preserved.⠀Distinguish⠀explicit⠀recall⠀from⠀a⠀sourced,⠀cued⠀association⠀carrying⠀the⠀learned⠀effect⠀of⠀a⠀person⠀or⠀experience.⠀Reactivation⠀is⠀not⠀automatic⠀strengthening⠀or⠀restored⠀episodic⠀detail.\n{{/if}}{{#if {{getvar::NMPg_affect}}}}\nAFFECT⠀/⠀COGNITION:⠀Let⠀the⠀actual⠀emotional⠀mixture,⠀attention,⠀load,⠀flexibility⠀and⠀inhibition⠀constrain⠀interpretation⠀and⠀expression.⠀An⠀unchanged⠀value⠀may⠀still⠀matter.⠀Do⠀not⠀assign⠀a⠀mood⠀to⠀justify⠀a⠀preselected⠀line.\n{{/if}}{{#if {{getvar::NMPg_choice}}}}\nMOTIVATION⠀/⠀CHOICE:⠀Retain⠀separate⠀desire,⠀willingness,⠀aversion,⠀perceived⠀cost,⠀action⠀comfort,⠀opportunity,⠀feasibility,⠀constraints⠀and⠀communicated⠀permission.⠀Apply⠀the⠀active⠀D-W-O⠀and⠀character-friction⠀guidance⠀to⠀the⠀same⠀scoped⠀option.⠀Ignore,⠀wait,⠀consider,⠀seek,⠀initiate,⠀negotiate,⠀attempt,⠀commit⠀and⠀withdraw⠀are⠀alternatives,⠀not⠀mandatory⠀stages.⠀Wanting,⠀choosing,⠀permission⠀and⠀accomplishing⠀are⠀different⠀facts;⠀scores⠀do⠀not⠀force⠀any⠀of⠀them.\n{{/if}}{{#if {{getvar::NMPg_social}}}}\nSOCIAL⠀/⠀RELATIONSHIPS:⠀Apply⠀only⠀supported⠀patterns⠀and⠀relevant⠀relationships.⠀Keep⠀trust,⠀affection,⠀familiarity⠀and⠀comfort⠀separate,⠀and⠀interpretations⠀person-specific.⠀A⠀strategy⠀or⠀bid⠀records⠀what⠀was⠀actually⠀attempted⠀and⠀received.⠀Waiting⠀has⠀a⠀real⠀release⠀condition⠀and⠀leaves⠀room⠀for⠀other⠀goals;⠀no⠀invented⠀acceptance,⠀resistance⠀or⠀new⠀bid⠀to⠀fill⠀a⠀panel.⠀Let⠀the⠀person-specific⠀experienced⠀effects⠀and⠀learned⠀expectations⠀influence⠀present⠀attraction⠀to⠀company,⠀comfort⠀and⠀interpretation.⠀Do⠀not⠀manufacture⠀chemistry⠀or⠀source⠀memories⠀to⠀fit⠀a⠀serious/casual⠀label.\n{{/if}}{{#if {{getvar::NMPg_workspace}}}}\nCONSCIOUS⠀WORKSPACE:⠀Distinguish⠀spontaneous⠀content⠀from⠀an⠀actual⠀chosen⠀mental⠀operation.⠀Use⠀this⠀person's⠀available⠀knowledge⠀and⠀repertoire.⠀Awareness,⠀aim,⠀method,⠀attempt⠀and⠀observed⠀result⠀differ.⠀Habit⠀or⠀impulse⠀need⠀not⠀become⠀a⠀conscious⠀calculation;⠀recording⠀a⠀process⠀never⠀executes⠀it⠀again.\n{{/if}}\n{{getvar::PlanStep_RelationshipStage}}\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_EmotionalMatrix}}{{/if}}\n\n4.⠀LIVE⠀THE⠀SHARED⠀INTERVAL\nBefore⠀each⠀authored⠀beat,⠀settle⠀the⠀relevant⠀perception,⠀thought⠀or⠀impulse⠀available⠀at⠀that⠀instant.⠀Let⠀conduct⠀follow⠀it,⠀then⠀admit⠀only⠀its⠀actual⠀consequences⠀into⠀subsequent⠀experience.⠀A⠀later⠀discovery⠀affects⠀the⠀next⠀act,⠀not⠀an⠀earlier⠀motive.⠀Interleave⠀characters⠀through⠀one⠀shared⠀clock⠀and⠀event⠀order;⠀prose⠀length⠀creates⠀no⠀extra⠀elapsed⠀time.\n\n{{#if {{getvar::PlanStep_CharacterTurnSimulation}}}}Character⠀Turn⠀Simulation⠀owns⠀the⠀shared⠀order⠀of⠀these⠀actions⠀and⠀outcomes;⠀do⠀not⠀run⠀them⠀twice.{{/if}}⠀Later⠀checks⠀reuse⠀settled⠀state.⠀A⠀new⠀event⠀may⠀change⠀a⠀receiving⠀field⠀again;⠀rereading⠀the⠀same⠀cause⠀may⠀not.⠀An⠀attempted⠀action⠀remains⠀pending⠀wherever⠀outcome,⠀opportunity⠀or⠀another⠀participant's⠀response⠀is⠀genuinely⠀unavailable.\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_CharacterTurnSimulation}}{{/if}}\n{{#if {{.NSSCount > 1}}}}{{else}}{{getvar::PlanStep_PhysicalGround}}{{/if}}\n{{#if {{getvar::NMPg_resolution}}}}\nWORLD⠀CONTEXT:⠀Use⠀the⠀active⠀world⠀logic,⠀register,⠀genre,⠀difficulty⠀and⠀role-granted⠀outcome⠀authority.⠀Narrator-level⠀story⠀context⠀does⠀not⠀become⠀private⠀knowledge.⠀Retain⠀only⠀useful⠀current⠀context⠀and⠀actual⠀resolution⠀records.\n{{getvar::NemoResolutionMPDirective}}\n{{/if}}\n\n5.⠀COMPOSE⠀THROUGH⠀THE⠀SELECTED⠀VOICE\nResolved⠀Vex⠀identities:⠀{{getvar::VexPlanName}}.\nPlanning⠀lens:⠀{{getvar::VexPlanCore}}\nAnchor:⠀{{getvar::VexPlanAnchor}}\nQuestion:⠀{{getvar::VexPlanQuestion}}\nKeep⠀narrator⠀identity,⠀character⠀identity,⠀permitted⠀private⠀access⠀and⠀voluntary⠀authorship⠀separate.⠀Do⠀not⠀reenact⠀the⠀calibration⠀interview⠀or⠀diagnose⠀the⠀cast⠀in⠀the⠀narrator's⠀voice.⠀Select⠀the⠀telling⠀after⠀establishing⠀the⠀lived⠀causes,⠀rather⠀than⠀altering⠀minds⠀to⠀fit⠀an⠀attractive⠀ending.\n{{#if {{getvar::NMPg_voice}}}}\nEMBODIED⠀VOICE:⠀Apply⠀the⠀enabled⠀narration/speech⠀component⠀through⠀the⠀selected⠀Nemo⠀Perspective,⠀language⠀and⠀prose⠀convention.⠀Private⠀experience⠀and⠀public⠀wording⠀may⠀agree⠀or⠀differ⠀for⠀a⠀character-grounded⠀reason.⠀A⠀short⠀public⠀line⠀need⠀not⠀imply⠀a⠀short⠀inner⠀experience.⠀No⠀clinical⠀readout⠀or⠀compulsory⠀gesture⠀substitutes⠀for⠀inhabited⠀fiction.\n{{/if}}\n{{#if {{getvar::NTDBlock}}}}{{getvar::NTDBlock}}{{else}}{{getvar::PlanStep_CourseCorrect}}{{/if}}\n{{#if {{getvar::NTDBlock}}}}{{else}}{{getvar::PlanStep_PacingBeats}}{{/if}}\n{{#if {{getvar::NTDBlock}}}}{{else}}{{getvar::PlanStep_NarrativeHook}}{{/if}}\n{{getvar::PlanStep_NSFWFocus}}\n{{getvar::PlanStep_VoiceCraft}}\n{{#if {{getvar::NIFBlock}}}}{{else}}{{getvar::PlanStep_Subtext}}{{/if}}\n\n6.⠀REPAIR⠀THE⠀CANDIDATE,⠀NOT⠀THE⠀HISTORY\nMENTAL⠀PROJECTION:⠀CONSISTENCY⠀AND⠀ENDPOINT⠀CHECK\nUse⠀the⠀host's⠀existing⠀candidate⠀review,⠀compliance⠀step⠀or⠀Workbench⠀SHAPE⠀stage;⠀this⠀is⠀its⠀mental-state⠀checklist,⠀not⠀another⠀simulation⠀or⠀review⠀loop.⠀Before⠀publication,⠀check⠀each⠀material⠀thought,⠀line⠀and⠀act⠀against⠀that⠀person's⠀inherited⠀state,⠀available⠀knowledge⠀and⠀actual⠀chronology.⠀Repair⠀unsupported⠀numerical⠀drift,⠀lost⠀owner/scope,⠀invented⠀knowledge,⠀disabled-field⠀effects,⠀backdated⠀motives⠀and⠀duplicate⠀causal⠀charges.⠀Preserve⠀genuine⠀uncertainty,⠀unchanged⠀values⠀and⠀incomplete⠀actions.⠀Character⠀speech⠀alone⠀does⠀not⠀overwrite⠀established⠀private⠀state.⠀Check⠀material⠀bodily⠀effects⠀and⠀relationship⠀changes⠀against⠀their⠀actual⠀causes⠀and⠀available⠀history:⠀no⠀invented⠀source⠀episode,⠀forced⠀symptom,⠀label-to-chemistry⠀inference,⠀copied⠀partner⠀state⠀or⠀second⠀reward⠀for⠀the⠀same⠀cue.⠀Retain⠀supported⠀implicit⠀associations⠀without⠀calling⠀them⠀conscious⠀recall.\n\nRepair⠀the⠀candidate⠀and⠀reconcile⠀its⠀endpoint⠀from⠀the⠀SAME⠀predecessor⠀and⠀accepted⠀events.⠀Do⠀not⠀simulate⠀discarded⠀versions⠀as⠀lived⠀events⠀or⠀charge⠀a⠀correction⠀as⠀another⠀cause.⠀Check⠀one⠀complete⠀source-schema⠀snapshot⠀per⠀eligible⠀character,⠀stable⠀IDs,⠀retained⠀records,⠀correct⠀privacy⠀and⠀the⠀existing⠀tracker⠀host.⠀A⠀Scratchpad⠀summary⠀references⠀the⠀same⠀endpoint;⠀it⠀does⠀not⠀own⠀duplicate⠀numerical⠀state.⠀Only⠀published⠀fiction⠀and⠀state⠀enter⠀continuity.⠀{{#if {{getvar::NMPg_map}}}}Map⠀annotations⠀are⠀read-only.{{/if}}⠀Never⠀put⠀model⠀deliberation⠀into⠀character⠀fields⠀or⠀replace⠀required⠀live⠀interiority⠀with⠀this⠀check.\n{{getvar::PlanTail_DraftAttack}}\n{{getvar::PlanTail_DraftCompliance}}{{#if {{getvar::NNPEnabled}}}}\n{{getvar::NNPAudit}}{{/if}}\n{{#if {{getvar::NRPReady}}}}{{getvar::NRPBlock}}{{else}}{{getvar::PlanStep_HTMLDesign}}{{/if}}\n{{#if {{getvar::NRPReady}}}}{{else}}{{getvar::PlanStep_HTMLMarkers}}{{/if}}\n\n7.⠀COMMIT⠀THE⠀ACCEPTED⠀ENDPOINT\nAfter⠀repair,⠀finalize⠀each⠀tracked⠀character's⠀endpoint⠀from⠀the⠀same⠀accepted⠀event⠀ledger.⠀Preserve⠀unchanged⠀values,⠀stable⠀IDs,⠀meaningful⠀retained⠀records⠀and⠀pending⠀actions.⠀Retrospective⠀self-account⠀belongs⠀to⠀this⠀endpoint,⠀not⠀to⠀an⠀earlier⠀cause.\n{{#if {{getvar::NMPg_map}}}}\nREAD-ONLY⠀MAP:⠀Derive⠀the⠀selected⠀neural⠀pathway⠀annotations⠀from⠀actual⠀supported⠀state⠀links⠀only⠀after⠀the⠀endpoint⠀is⠀settled.⠀A⠀displayed⠀edge,⠀arrow⠀or⠀activity⠀score⠀is⠀never⠀another⠀cause⠀or⠀value⠀update.\n{{/if}}\nUse⠀the⠀existing⠀mental-projection/0.14⠀marker⠀grammar⠀with⠀required⠀character_key⠀and⠀timeline⠀text⠀fields⠀in⠀overview.⠀Final⠀publication⠀has⠀one⠀complete⠀snapshot⠀per⠀eligible⠀tracked⠀character⠀in⠀one⠀nemo-mp-state⠀envelope,⠀outside⠀planning/review;⠀the⠀adjacent⠀retention⠀capsule⠀must⠀carry⠀the⠀same⠀identity⠀pairs⠀and⠀accepted⠀timeline.⠀The⠀late⠀Tracker⠀Route⠀chooses⠀Standalone,⠀Scratchpad⠀Legacy⠀Deeper⠀Notes,⠀or⠀the⠀Modular⠀Mental⠀Projection⠀tab.⠀Do⠀not⠀change⠀the⠀layout,⠀create⠀a⠀second⠀tracker,⠀or⠀suppress⠀state⠀because⠀the⠀panel⠀is⠀hidden.⠀{{#if {{getvar::NemoPlanDraftEnabled}}}}Every⠀requested⠀complete⠀draft⠀contains⠀a⠀noncanonical⠀preview⠀of⠀that⠀same⠀endpoint;⠀only⠀accepted⠀published⠀fiction⠀and⠀state⠀enter⠀continuity.{{else}}Write⠀the⠀complete⠀state⠀once⠀with⠀the⠀published⠀response,⠀not⠀a⠀preview⠀inside⠀planning.{{/if}}⠀Revisions⠀and⠀verbatim⠀publication⠀are⠀not⠀additional⠀fictional⠀events.\n\nOn⠀Continue,⠀resume⠀the⠀same⠀interval⠀and⠀inherit⠀the⠀latest⠀complete⠀applicable⠀snapshot;⠀account⠀for⠀already-written⠀partial⠀narrative⠀once.⠀Never⠀claim⠀to⠀replace⠀text⠀already⠀emitted.⠀On⠀a⠀swipe,⠀use⠀the⠀active⠀branch's⠀predecessor,⠀not⠀discarded⠀alternatives.⠀Pure⠀OOC⠀does⠀not⠀advance⠀fiction⠀or⠀invent⠀a⠀character⠀to⠀fill⠀state.⠀Preserve⠀the⠀active⠀role's⠀stopping⠀point.\n{{getvar::PlanTail_FinalDraft}}\n{{getvar::PlanTail_MagpieWorkbench}}\n\n{{/setvar}}\n{{trim}}",
