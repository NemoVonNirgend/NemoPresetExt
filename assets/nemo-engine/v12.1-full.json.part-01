                "replaceString": "<style>.pk-plan{display:block;margin:.65em 0 1.05em;border:1px solid rgba(204,121,167,.28);border-left:3px solid #CC79A7;border-radius:.55rem;background:linear-gradient(105deg,rgba(204,121,167,.09),rgba(255,255,255,.015));font-size:.88em;color:#d7d3dc;overflow:hidden}.pk-plan>summary{display:flex;align-items:center;gap:.65em;padding:.58rem .85rem;cursor:pointer;list-style:none;user-select:none}.pk-plan>summary::-webkit-details-marker{display:none}.pk-plan>summary:before{content:\"▸\";color:#CC79A7;font-size:.9em;transition:transform .15s ease}.pk-plan[open]>summary:before{transform:rotate(90deg)}.pk-plan>summary>b{font-size:.72em;letter-spacing:.14em;text-transform:uppercase;color:#e2b2ce}.pk-plan>summary>i{margin-left:auto;font-size:.72em;font-style:normal;letter-spacing:.04em;opacity:.48}.pk-plan>div{padding:.72rem .95rem .82rem;border-top:1px solid rgba(204,121,167,.18);line-height:1.58;background:rgba(0,0,0,.12);max-height:min(72vh,52rem);overflow:auto}.pk-plan>div>p:first-child{margin-top:0}.pk-plan>div>p:last-child{margin-bottom:0}@media(max-width:640px){.pk-plan>summary>i{display:none}.pk-plan>div{max-height:70vh}}</style><details class=\"pk-plan\"><summary><b>Nemo workbench</b><i>planning · draft/attack when enabled · excluded from future context</i></summary><div>$1</div></details>",
