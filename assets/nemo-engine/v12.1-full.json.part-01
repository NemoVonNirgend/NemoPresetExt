                "replaceString": "<style>.mpv7 .mp-choice-record{border-color:rgba(180,181,229,.32);background:linear-gradient(145deg,rgba(161,149,210,.055),rgba(8,15,24,.20))}.mpv7 .mp-choice-record>.mp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;padding:13px}.mpv7 .mp-choice-record .mp-meter{align-self:stretch}.mpv7 .mp-choice-record .mp-meter-head{flex-wrap:wrap}.mpv7 .mp-choice-record .mp-reading-wrap{flex-wrap:wrap}.mpv7 .mp-choice-band{grid-column:1/-1;display:flex;align-items:center;gap:8px;padding:9px 11px;margin-top:3px;border-radius:7px;border:1px solid rgba(160,174,210,.20);background:rgba(125,145,185,.06);color:#d4daea;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.mpv7 .mp-choice-band small{margin-left:auto;font-weight:400;font-size:9px;letter-spacing:0;text-transform:none;color:#aab8cd}.mpv7 .mp-choice-band-internal{order:10;border-color:rgba(194,171,225,.30);color:#d7c3ed;background:rgba(180,147,211,.055)}.mpv7 .mp-choice-band-external{order:20;border-color:rgba(151,198,219,.30);color:#b1d9ea;background:rgba(111,166,195,.055)}.mpv7 .mp-choice-band-behaviour{order:30;border-color:rgba(145,209,173,.30);color:#b6dec5;background:rgba(118,176,145,.055)}.mpv7 .mp-choice-record [data-field='readiness_desires']{order:11}.mpv7 .mp-choice-record [data-field='willingness'],.mpv7 .mp-choice-record [data-field='aversion'],.mpv7 .mp-choice-record [data-field='cost_perception'],.mpv7 .mp-choice-record [data-field='action_comfort']{order:12}.mpv7 .mp-choice-record [data-field='readiness_aversions']{order:14}.mpv7 .mp-choice-record [data-field='readiness_costs']{order:15}.mpv7 .mp-choice-record [data-field='readiness_external_basis']{order:21}.mpv7 .mp-choice-record [data-field='opportunity'],.mpv7 .mp-choice-record [data-field='feasibility']{order:22}.mpv7 .mp-choice-record [data-field='readiness_constraints']{order:23}.mpv7 .mp-choice-record [data-field='readiness_behavior']{order:31;padding:9px 11px;border