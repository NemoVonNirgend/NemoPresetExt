            "identifier": "v11-000-variable-init",
            "name": "🔧 Init · Meta and optional directives",
            "content": "{{// @category Variable-Init }}{{// @icon 🔧 }}{{// @badge INIT }}{{// @tooltip Meta and optional directives. Required initialization data; keep enabled in the supplied order before selectors and resolvers. Part 1 of 1. }}{{// Source group: core-01; payload preserved. }}{{// V12 VARIABLE INITIALIZER — only slots that pass the Variable Rule (P1) live here. }}{{// Demoted families (genre, authors, formats, pacing, agency, world, augments, }}{{// difficulty, POV, tense, length, NSFW, fetish, utility) are PLAIN PROMPTS now }}{{// and have no content slots — only Name accumulators for the dashboard. }}{{// === META / OPTIONAL DIRECTIVES === }}{{setvar::VexMetaDirective::}}{{setvar::VexMeta_Genre::}}{{setvar::VexMeta_Style::}}{{setvar::VexMeta_Difficulty::}}{{setvar::VexMeta_World::}}{{setvar::VexMeta_NSFW::}}{{setvar::VexMeta_Utility::}}{{trim}}"
        },
