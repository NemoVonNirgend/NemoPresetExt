                "findRegex": "/(?<nitPrefix>(?:(?=(?<nitToken>(?:(?:^[ \\t]{0,3}(?:>[ \\t]?)*(?<nitFenceTick>`{3,})[^\\r\\n]*(?:\\r?\\n[\\s\\S]*?^[ \\t]{0,3}(?:>[ \\t]?)*\\k<nitFenceTick>`*[ \\t]*(?=\\r?$)|[\\s\\S]*))|(?:^[ \\t]{0,3}(?:>[ \\t]?)*(?<nitFenceTilde>~{3,})[^\\r\\n]*(?:\\r?\\n[\\s\\S]*?^[ \\t]{0,3}(?:>[ \\t]?)*\\k<nitFenceTilde>~*[ \\t]*(?=\\r?$)|[\\s\\S]*))|(?:^(?:(?: {4}|\\t)[^\\r\\n]*(?:\\r?\\n|(?![\\s\\S])))+)|(?:^[\\t ]*===[\\t ]*NEMO_(?<nitWorkbenchKind>WORKBENCH|EXACT_REVIEW)_BEGIN[\\t ]*===[^\\r\\n]*(?:\\r?\\n[\\s\\S]*?^[\\t ]*===[\\t ]*NEMO_\\k<nitWorkbenchKind>_END[\\t ]*===[\\t ]*|[\\s\\S]*))|(?:<!--(?:[\\s\\S]*?-->|[\\s\\S]*))|(?:<!\\[CDATA\\[(?:[\\s\\S]*?\\]\\]>|[\\s\\S]*))|(?:<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S]|<details\\b(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:(?!<\\/?details\\b)[\\s\\S])*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>)*<\\/details\\s*>|[\\s\\S]*))|(?:<(?<nitRawTag>style|script|pre|code|textarea|title|xmp|template|plaintext|iframe|noembed|noframes|think|thinking|plan|planning|nemo-interiority|nemo-pad|nemo-mp-state|nemo-mp-retain|mental_state|st-tracker(?:-[\\w-]+)?)(?=[\\s/>])(?:[^<>\"']|\"[^\"]*\"|'[^']*')*>(?:[\\s\\S]*?<\\/\\k<nitRawTag>\\s*>|[\\s\\S]*))|(?:&lt;\\s*(?<nitEscapedTag>mental_state|nemo-interiority|nemo-mp-state|nemo-mp-retain)\\s*&gt;[\\s\\S]*?(?:&lt;\\s*\\/\\s