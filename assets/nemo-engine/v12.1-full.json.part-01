        {
            "identifier": "nemo-init-recipe-index",
            "name": "🔧 Init · Writing Recipe Index",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Variable-Init }}{{// @icon 🔧 }}{{// @badge INIT }}{{// @tooltip Compact recipe ID index. Runs after recipe selectors and before the selected genre partition. }}{{setvar::NG_action_adventure::aa}}{{setvar::NG_character_drama::ab}}{{setvar::NG_comedy::ac}}{{setvar::NG_crime::ad}}{{setvar::NG_cyberpunk_noir::ae}}{{setvar::NG_erotica::af}}{{setvar::NG_fantasy::ag}}{{setvar::NG_high_fantasy::ah}}{{setvar::NG_historical_fiction::ai}}{{setvar::NG_horror::aj}}{{setvar::NG_mystery::ak}}{{setvar::NG_progression_fantasy::al}}{{setvar::NG_romance::am}}{{setvar::NG_science_fiction::an}}{{setvar::NG_slice_of_life::ao}}{{setvar::NG_thriller::ap}}{{setvar::NG_tragedy::aq}}{{setvar::NA_akira_unresolved::aa}}{{setvar::NA_brandon_sanderson::ab}}{{setvar::NA_chuck_palahniuk::ac}}{{setvar::NA_cormac_mccarthy::ad}}{{setvar::NA_douglas_adams::ae}}{{setvar::NA_ernest_hemingway::af}}{{setvar::NA_fyodor_dostoevsky::ag}}{{setvar::NA_garcia_marquez::ah}}{{setvar::NA_gu_long::ai}}{{setvar::NA_haruki_murakami::aj}}{{setvar::NA_jane_austen::ak}}{{setvar::NA_jin_yong::al}}{{setvar::NA_jun_maeda::am}}{{setvar::NA_kamachi_kazuma::an}}{{setvar::NA_li_bihua::ao}}{{setvar::NA_lu_xun::ap}}{{setvar::NA_masashi_kishimoto::aq}}{{setvar::NA_neil_gaiman::ar}}{{setvar::NA_nemo_manuscript::as}}{{setvar::NA_nisio_isin::at}}{{setvar::NA_no_named_author::au}}{{setvar::NA_quentin_tarantino::av}}{{setvar::NA_salman_rushdie::aw}}{{setvar::NA_stephen_king::ax}}{{setvar::NA_terry_pratchett::ay}}{{setvar::NA_wang_xiaobo::az}}{{setvar::NA_yasunari_kawabata::ba}}{{setvar::NS_angsty_emotionally_turbulent::aa}}{{setvar::NS_chat_roleplay::ab}}{{setvar::NS_chinese_literary_traditions::ac}}{{setvar::NS_compressed_gritty_prose::ad}}{{setvar::NS_epistolary_documents::ae}}{{setvar::NS_fluffy_comforting::af}}{{setvar::NS_formal_literary_novel::ag}}{{setvar::NS_framed_oral_storytelling_arabian_nights_inspired::ah}}{{setvar::NS_german_language_literary_traditions::ai}}{{setvar::NS_gothic_punk::aj}}{{setvar::NS_indian_literary_traditions::ak}}{{setvar::NS_japanese_literary_traditions::al}}{{setvar::NS_latin_american_literary_traditions::am}}{{setvar::NS_light_novel::an}}{{setvar::NS_lyrical_prose::ao}}{{setvar::NS_melancholic_reflective::ap}}{{setvar::NS_middle_eastern_literary_traditions::aq}}{{setvar::NS_minimalist_prose::ar}}{{setvar::NS_modern_literature::as}}{{setvar::NS_relationship_centric_fanfiction_ao3_inspired::at}}{{setvar::NS_saga_oral_epic::au}}{{setvar::NS_scandinavian_literary_traditions::av}}{{setvar::NS_screenplay::aw}}{{setvar::NS_stage_play::ax}}{{setvar::NS_stream_of_consciousness::ay}}{{setvar::NS_text_messages_chat_transcript::az}}{{setvar::NS_visual_novel::ba}}{{setvar::NS_web_serial::bb}}{{trim}}",
            "enabled": true,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
            "forbid_overrides": false
        },
        {
            "identifier": "nemo-recipe-selection-sanitize",
            "name": "🧩 Writing Recipe · Selection Guard",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Variable-Init }}{{// @hidden }}{{// @badge RESOLVER }}{{// @tooltip Guard malformed or unknown recipe IDs before loading the selected partition. }}\n{{#if {{getvar::NG_{{getvar::NCGenreId}}}}}}{{else}}{{setvar::NCGenreId::slice_of_life}}{{setvar::NCAuthorId::nemo_manuscript}}{{setvar::NCStyleId::modern_literature}}{{setvar::GenreName::Slice of Life}}{{setvar::InfluenceName::Nemo / Manuscript Voice}}{{setvar::FormatName::Modern Literature / Contemporary Novel}}{{/if}}\n{{#if {{getvar::NA_{{getvar::NCAuthorId}}}}}}{{else}}{{setvar::NCAuthorId::nemo_manuscript}}{{setvar::InfluenceName::Nemo / Manuscript Voice}}{{/if}}\n{{#if {{getvar::NS_{{getvar::NCStyleId}}}}}}{{else}}{{setvar::NCStyleId::modern_literature}}{{setvar::FormatName::Modern Literature / Contemporary Novel}}{{/if}}{{trim}}",
            "enabled": true,
