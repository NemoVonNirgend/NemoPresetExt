            "role": "system",
            "content": "{{// @category Variable-Init }}{{// @icon 🔧 }}{{// @badge INIT }}{{// @tooltip Compact recipe ID index. Runs after recipe selectors and before the selected genre partition. }}{{setvar::NG_action_adventure::aa}}{{setvar::NG_character_drama::ab}}{{setvar::NG_comedy::ac}}{{setvar::NG_crime::ad}}{{setvar::NG_cyberpunk_noir::ae}}{{setvar::NG_erotica::af}}{{setvar::NG_fantasy::ag}}{{setvar::NG_high_fantasy::ah}}{{setvar::NG_historical_fiction::ai}}{{setvar::NG_horror::aj}}{{setvar::NG_mystery::ak}}{{setvar::NG_progression_fantasy::al}}{{setvar::NG_romance::am}}{{setvar::NG_science_fiction::an}}{{setvar::NG_slice_of_life::ao}}{{setvar::NG_thriller::ap}}{{setvar::NG_tragedy::aq}}{{setvar::NA_akira_unresolved::aa}}{{setvar::NA_brandon_sanderson::ab}}{{setvar::NA_chuck_palahniuk::ac}}{{setvar::NA_cormac_mccarthy::ad}}{{setvar::NA_douglas_adams::ae}}{{setvar::NA_ernest_hemingway::af}}{{setvar::NA_fyodor_dostoevsky::ag}}{{setvar::NA_garcia_marquez::ah}}{{setvar::NA_gu_long::ai}}{{setvar::NA_haruki_murakami::aj}}{{setvar::NA_jane_austen::ak}}{{setvar::NA_jin_yong::al}}{{setvar::NA_jun_maeda::am}}{{setvar::NA_kamachi_kazuma::an}}{{setvar::NA_li_bihua::ao}}{{setvar::NA_lu_xun::ap}}{{setvar::NA_masashi_kishimoto::aq}}{{setvar::NA_neil_gaiman::ar}}{{setvar::NA_nemo_manuscript::as}}{{setvar::NA_nisio_isin::at}}{{setvar::NA_no_named_author::au}}{{setvar::NA_quentin_tarantino::av}}{{setvar::NA_salman_rushdie::aw}}{{setvar::NA_stephen_king::ax}}{{setvar::NA_terry_pratchett::ay}}{{setvar::NA_wang_xiaobo::az}}{{setvar::NA_yasunari_kawabata::ba}}{{setvar::NS_angsty_emotionally_turbulent::aa}}{{setvar::NS_chat_roleplay::ab}}{{setvar::NS_chinese_literary_traditions::ac}}{{setvar::NS_compressed_gritty_prose::ad}}{{setvar::NS_epistolary_documents::ae}}{{setvar::NS_fluffy_comforting::af}}{{setvar::NS_formal_literary_novel::ag}}{{setvar::NS_framed_oral_storytelling_arabian_nights_inspired::ah}}{{setvar::NS_german_language_literary_traditions::ai}}{{setvar::NS_gothic_punk: