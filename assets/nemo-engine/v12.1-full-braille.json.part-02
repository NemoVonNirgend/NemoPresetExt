        {
            "identifier": "nemo-recipe-selection-sanitize",
            "name": "🧩 Writing Recipe · Selection Guard",
            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "{{// @category Variable-Init }}{{// @hidden }}{{// @badge RESOLVER }}{{// @tooltip Guard malformed or unknown recipe IDs before loading the selected partition. }}\n{{#if {{getvar::NG_{{getvar::NCGenreId}}}}}}{{else}}{{setvar::NCGenreId::slice_of_life}}{{setvar::NCAuthorId::nemo_manuscript}}{{setvar::NCStyleId::modern_literature}}{{setvar::GenreName::Slice⠀of⠀Life}}{{setvar::InfluenceName::Nemo⠀/⠀Manuscript⠀Voice}}{{setvar::FormatName::Modern⠀Literature⠀/⠀Contemporary⠀Novel}}{{/if}}\n{{#if {{getvar::NA_{{getvar::NCAuthorId}}}}}}{{else}}{{setvar::NCAuthorId::nemo_manuscript}}{{setvar::InfluenceName::Nemo⠀/⠀Manuscript⠀Voice}}{{/if}}\n{{#if {{getvar::NS_{{getvar::NCStyleId}}}}}}{{else}}{{setvar::NCStyleId::modern_literature}}{{setvar::FormatName::Modern⠀Literature⠀/⠀Contemporary⠀Novel}}{{/if}}{{trim}}",
