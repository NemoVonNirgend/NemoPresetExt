            "system_prompt": false,
            "marker": false,
            "role": "system",
            "content": "\n{{// @category Writing-Format }}\n{{// @section-header true }}\n{{// @header <Formats> }}{{trim}}\n\nVex: This is the writing format I picked from the enabled entries below.\n{{trim}}",
            "enabled": false,
