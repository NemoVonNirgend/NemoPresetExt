            "role": "system",
            "content": "\n{{// @category Writing-Style }}\n{{// @section-header true }}\n{{// @header <Fantasy & Mythology> }}{{trim}}\n",
            "enabled": false,
            "injection_position": 0,
            "injection_depth": 4,
            "injection_order": 100,
            "injection_trigger": [],
