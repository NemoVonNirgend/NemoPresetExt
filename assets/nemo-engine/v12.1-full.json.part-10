            "identifier": "v11-535-classic-council-prefil",
            "name": "🕰️ Legacy: Selected Planning Entry Cue",
            "content": "{{// @category Planning }}{{// @tooltip Optional legacy entry cue. The Assistant Sudo Prefill supplies the selected template; this cue adds no copy or opening tag. }}{{// @color #B8860B }}{{// @icon 🪞 }}{{// @badge CLASSIC }}\n{{#if {{getvar::NemoPlanReady}}}}[OOC: Use the planning format supplied with the assistant's writing settings.]{{/if}}{{trim}}"
